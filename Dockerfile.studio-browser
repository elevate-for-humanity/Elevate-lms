FROM mcr.microsoft.com/playwright:v1.57.0-noble

ARG NF_GIT_SHA=MISSING

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY services/studio-browser/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /tmp/* \
    && chown -R pwuser:pwuser /app
COPY services/studio-browser/server.mjs ./server.mjs

ENV NODE_ENV=production PORT=3100 GIT_SHA=${NF_GIT_SHA}
EXPOSE 3100
USER pwuser
CMD ["node", "server.mjs"]
