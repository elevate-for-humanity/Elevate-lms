# syntax=docker/dockerfile:1.7
# Dockerfile.marketing - Northflank Marketing Service
# Serves www.elevateforhumanity.org
#
# CRITICAL: This Dockerfile was fixed to resolve path mismatches.

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE_OUTPUT=1

# Cache invalidation marker - v5: timestamp-based to force Docker layer rebuild
RUN echo "nf-cache-invalidate-marketing-$(date +%Y%m%d-%H%M%S)"

RUN corepack enable
WORKDIR /app

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM base AS builder

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages/*/package.json ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

COPY . .

# Generate version.json inside Docker build (not on GitHub Actions)
# This is needed because Northflank pulls from GitHub, not from the GHA runner
RUN echo "{\"service\":\"marketing\",\"commit\":\"${GIT_SHA:-unknown}\",\"builtAt\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" > ./public/version.json

# Build args
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GIT_SHA
ARG BUILD_TIMESTAMP

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CI=true
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Build Marketing app
RUN pnpm --filter @elevate/marketing build --no-lint

# =============================================================================
# STAGE 3: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

# Redeclare build args for runtime stage
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

# Install curl for health check
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Copy the entire Next.js build output to /app/
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next ./.next

# Copy public folder (contains version.json generated in builder stage)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Set ownership on public folder
RUN chown -R nextjs:nodejs ./public

# Copy node_modules (needed for runtime dependencies)
COPY --from=builder /app/node_modules ./node_modules

# Create a simple server that serves the Next.js app
RUN echo 'const { createServer } = require("http"); \
const { parse } = require("url"); \
const next = require("next"); \
\
const dev = process.env.NODE_ENV !== "production"; \
const hostname = process.env.HOSTNAME || "0.0.0.0"; \
const port = parseInt(process.env.PORT || "3000", 10); \
\
const app = next({ dev, hostname, port }); \
const handle = app.getRequestHandler(); \
\
app.prepare().then(() => { \
  createServer((req, res) => { \
    const parsedUrl = parse(req.url, true); \
    handle(req, res, parsedUrl); \
  }).listen(port, hostname, (err) => { \
    if (err) throw err; \
    console.info("> Marketing ready on http://" + hostname + ":" + port); \
  }); \
});' > ./server.cjs && chmod +x ./server.cjs

USER nextjs

EXPOSE 8080

# Health check - use root path which always works
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -sf http://127.0.0.1:8080/api/live || curl -sf http://127.0.0.1:8080/ || exit 1

# Start the marketing application
CMD ["node", "--max-old-space-size=4096", "server.cjs"]
