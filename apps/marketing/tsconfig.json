{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "./**/*.js",
    "./**/*.mjs",
    "./**/*.ts",
    "./**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../apps/admin",
    "../../apps/lms",
    "../../app-legacy",
    "../../scripts",
    "../../server",
    "../../supabase",
    "../../tests",
    "../../tools",
    "../../workers",
    "../../**/*.test.ts",
    "../../**/*.test.tsx",
    "../../**/*.spec.ts",
    "../../**/*.spec.tsx"
  ]
}
