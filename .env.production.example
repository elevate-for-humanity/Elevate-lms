# ============================================================
# ELEVATE FOR HUMANITY - PRODUCTION ENVIRONMENT
# ============================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production or real secret values to version control.

# =============================================================================
# SECTION 1: DATABASE & SUPABASE
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL=postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
POSTGRES_PASSWORD=your-db-password

# =============================================================================
# SECTION 2: AUTHENTICATION & CANONICAL SERVICE ORIGINS
# =============================================================================

NEXTAUTH_SECRET=generate-a-32-character-random-string
NEXTAUTH_URL=https://www.elevateforhumanity.org
NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
NEXT_PUBLIC_LMS_URL=https://app.elevateforhumanity.org
NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
# Root/registrable domain only. Do not set this to www.elevateforhumanity.org.
NEXT_PUBLIC_CANONICAL_DOMAIN=elevateforhumanity.org

# =============================================================================
# SECTION 3: ORGANIZATION IDENTITY
# =============================================================================

NEXT_PUBLIC_ORG_NAME=Elevate for Humanity
NEXT_PUBLIC_ORG_LEGAL_NAME=Elevate for Humanity Career & Technical Institute
NEXT_PUBLIC_SUPPORT_EMAIL=support@elevateforhumanity.org
NEXT_PUBLIC_SUPPORT_PHONE=(317) 314-3757
NEXT_PUBLIC_EMAIL_FROM_NAME=Elevate for Humanity
NEXT_PUBLIC_EMAIL_FROM_ADDRESS=noreply@elevateforhumanity.org
NEXT_PUBLIC_CERT_HOLDER=Elevate for Humanity

# =============================================================================
# SECTION 4: PAYMENTS - STRIPE
# =============================================================================

STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET_STORE=whsec_...
STRIPE_WEBHOOK_SECRET_APPLICATION_FEE=whsec_...
STRIPE_WEBHOOK_SECRET_HOST_SHOP=whsec_...
STRIPE_WEBHOOK_SECRET_SUBSCRIPTIONS=whsec_...

STRIPE_PRICE_CR_GUIDE=price_...
STRIPE_PRICE_CR_ENTERPRISE=price_...
STRIPE_PRICE_APPLICATION_FEE=price_...
STRIPE_PRICE_STARTER_LICENSE=price_...
STRIPE_PRICE_PRO_LICENSE=price_...
STRIPE_PRICE_ENTERPRISE_LICENSE=price_...
STRIPE_PRICE_WORKFLOW_STUDIO=price_...
STRIPE_PRICE_TESTING_CENTER=price_...
STRIPE_PRICE_DEV_STUDIO=price_...
STRIPE_PRICE_BNPL_WEEKLY=price_...
STRIPE_PRICE_BNPL_MONTHLY=price_...

# =============================================================================
# SECTION 5: EMAIL
# =============================================================================

RESEND_API_KEY=re_...
EMAIL_FROM=noreply@elevateforhumanity.org
EMAIL_FROM_NAME=Elevate for Humanity
# Alternative provider if enabled:
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@elevateforhumanity.org

# =============================================================================
# SECTION 6: AI PROVIDERS
# =============================================================================

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=your-approved-anthropic-model
ANTHROPIC_MAX_TOKENS=4096
OPENAI_API_KEY=sk-...
OPENAI_MODEL=your-approved-openai-model
OPENAI_MAX_TOKENS=4096

# =============================================================================
# SECTION 7: MEDIA / EXTERNAL DATA
# =============================================================================

PEXELS_API_KEY=...
ADZUNA_APP_ID=...
ADZUNA_APP_KEY=...
ADZUNA_COUNTRY=us

# =============================================================================
# SECTION 8: FILE STORAGE - CLOUDFLARE R2
# =============================================================================

R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=elevate-media
HANDBOOK_PDF_URL=https://your-bucket.r2.dev/handbooks/apprentice-handbook.pdf

# =============================================================================
# SECTION 9: LICENSING SYSTEM
# =============================================================================

LICENSING_MODE=production
LICENSING_SECRET_KEY=generate-a-secure-random-key

# =============================================================================
# SECTION 10: SOCIAL / OPTIONAL INTEGRATIONS
# =============================================================================

FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
FACEBOOK_ACCESS_TOKEN=...
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...
TIKTOK_APP_KEY=...
TIKTOK_APP_SECRET=...

# =============================================================================
# SECTION 11: GITHUB / DEV STUDIO
# =============================================================================

GITHUB_TOKEN=github-token-with-repository-contents-permission
GITHUB_REPO=elevate-for-humanity/Elevate-lms
GITHUB_REPOSITORY=elevate-for-humanity/Elevate-lms
GITHUB_BRANCH=main
DEVSTUDIO_DEVCONTAINER_MODE=github-only
# Remote Studio shell, if enabled:
STUDIO_SHELL_WS_URL=wss://your-studio-shell.example
STUDIO_SHELL_SECRET=generate-a-secure-random-key
STUDIO_TOKEN_SECRET=generate-a-secure-random-key

# =============================================================================
# SECTION 12: NORTHFLANK DEPLOYMENT
# =============================================================================

NORTHFLANK_TEAM_ID=elevates-team
NORTHFLANK_PROJECT_ID=elevate-platform
NORTHFLANK_API_TOKEN=...
NORTHFLANK_MARKETING_SERVICE_ID=elevate-marketing
NORTHFLANK_LMS_SERVICE_ID=elevate-lms
NORTHFLANK_ADMIN_SERVICE_ID=elevate-admin
NORTHFLANK_SECRET_GROUP_ID=elevate-production-env
NODE_ENV=production

# =============================================================================
# SECTION 13: LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=info
SENTRY_DSN=...
