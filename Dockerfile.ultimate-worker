FROM node:22-bookworm-slim
WORKDIR /app

RUN npm init -y >/dev/null 2>&1 \
    && npm install --omit=dev --no-audit --no-fund @supabase/supabase-js tsx server-only

COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib/ultimate-course-builder ./lib/ultimate-course-builder
COPY lib/industry/onet.ts ./lib/industry/onet.ts
COPY lib/industry/careeronestop.ts ./lib/industry/careeronestop.ts
COPY lib/onet/soc-map.ts ./lib/onet/soc-map.ts

ENV NODE_ENV=production
# server-only uses the react-server conditional export. The standalone worker is
# server code, so make that contract explicit instead of loading the package's
# browser/client guard.
ENV NODE_OPTIONS="--conditions=react-server"

# Fail image construction if the worker's real import graph reaches an uncopied
# platform alias or undeclared package. Check both the eager worker path and the
# two lazy media adapters that execute at narration/render stages.
RUN ./node_modules/.bin/tsx -e "Promise.all([import('./lib/ultimate-course-builder/worker/process-job.ts'),import('./lib/ultimate-course-builder/adapters/platform-narration.ts'),import('./lib/ultimate-course-builder/adapters/platform-renderer.ts')]).then(()=>console.log('ultimate-worker-import-graph-ok'))"

CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]
