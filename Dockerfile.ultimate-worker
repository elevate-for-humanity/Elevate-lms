FROM node:22-bookworm-slim
WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends chromium ffmpeg espeak-ng ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile --prod --strict-peer-dependencies=false

COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib ./lib
COPY server ./server
COPY remotion-src ./remotion-src
COPY public ./public

ENV NODE_ENV=production
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]
