# Dockerfile.marketing
# Specialized for Public Pages / (marketing) / store
# REVERTED TO GREEN BUILD LOGIC (115c099)

FROM node:22-bookworm AS builder

# Cache invalidation
RUN echo "nf-cache-invalidate-20260629-marketing-v4"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 build-essential ca-certificates libcairo2-dev libpango1.0-dev \
    libjpeg-dev libgif-dev librsvg2-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY . .

# Run the splitter
ENV BUILD_SCOPE=MARKETING
RUN node scripts/split-app.mjs

# Stable PNPM
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

# 1. Install ALL dependencies
RUN pnpm install --no-frozen-lockfile

# 2. Build with 6GB Limit
ENV NODE_OPTIONS=--max-old-space-size=6144
ENV NEXT_STANDALONE_OUTPUT=1
RUN pnpm run build:lms:compile

# --- Runner Stage ---
FROM node:22-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/.next/server ./.next/server
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 8080
CMD ["node", "--max-old-space-size=4096", "--max-http-header-size=32768", "server.js"]
