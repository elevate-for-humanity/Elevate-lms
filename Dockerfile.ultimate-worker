FROM node:22-bookworm-slim
WORKDIR /workspace
COPY workers/ultimate-package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib/ultimate-course-builder/worker/job-queue.ts ./lib/ultimate-course-builder/worker/job-queue.ts
COPY lib/ultimate-course-builder/worker/dispatcher.ts ./lib/ultimate-course-builder/worker/dispatcher.ts
ENV NODE_ENV=production
CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]
