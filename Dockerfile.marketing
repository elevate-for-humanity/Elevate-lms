# syntax=docker/dockerfile:1.7
# Dockerfile.marketing - Northflank Marketing Service
# Serves www.elevateforhumanity.org
#
# Uses Next.js standalone output for minimal production image

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates curl git && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable
WORKDIR /app

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM base AS builder

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages/*/package.json ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

COPY . .

# Build args - GIT_SHA passed from Northflank
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CI=true
ENV NEXT_STANDALONE_OUTPUT=1
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Build Marketing app (outputs standalone to .next/standalone)
RUN pnpm --filter @elevate/marketing build

# =============================================================================
# STAGE 3: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

# Install curl for health check only
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Copy standalone output (server.js at /.next/standalone/ — server.js runs from /app/)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Copy static assets (server expects at ./apps/marketing/.next/static)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./apps/marketing/.next/static

# Copy public folder (server expects at ./apps/marketing/public)
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/public ./apps/marketing/public

USER nextjs

EXPOSE 8080

# Health check - verify API returns proper response
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -sf http://127.0.0.1:8080/api/health || exit 1

# Start the standalone Next.js server
CMD ["node", "server.js"]
