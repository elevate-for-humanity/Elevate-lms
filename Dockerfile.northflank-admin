# Dockerfile.northflank-admin
# Fresh rewrite for Elevate Admin (apps/admin Next.js app)

FROM node:22-bookworm AS builder

# Cache invalidation marker
RUN echo "nf-cache-invalidate-20260626-npm-fix"

# Install system deps for native modules (sharp, canvas, pdf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    ca-certificates \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests and source
COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# P0-3: 12GB heap for admin builds
ENV NODE_OPTIONS=--max-old-space-size=12288
ENV BUILD_SCOPE=1
ENV NEXT_STANDALONE_OUTPUT=1
ENV CI=true
# Enable webpack cache
ENV DISABLE_WEBPACK_FILESYSTEM_CACHE=
# Persistent build cache
ENV NEXT_BUILD_CACHE=/cache/.next

# Create persistent cache directory
RUN mkdir -p /cache/.next && chmod 755 /cache/.next

# Install dependencies
RUN npm ci

# Build Admin Next.js
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_SITE_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_PUBLIC_SITE_URL=$NEXT_PUBLIC_PUBLIC_SITE_URL

WORKDIR /app/apps/admin
# P0-3: 12GB memory for admin builds
RUN NODE_OPTIONS='--max-old-space-size=12288' NEXT_BUILD_CACHE=/cache/.next npm run build
WORKDIR /app

# --- runtime stage ---
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
# Fixed: Runtime memory limit
ENV NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /app

# Copy standalone build
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder /app/apps/admin/.next/server ./apps/admin/.next/server
COPY --from=builder /app/public ./public
COPY --from=builder /app/apps/admin/public ./apps/admin/public

# Copy full node_modules from builder (uses npm hoisting)
COPY --from=builder /app/node_modules ./node_modules

COPY --from=builder /app/apps/admin/server.js ./apps/admin/server.js

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/api/ping || exit 1

CMD ["node", "--max-old-space-size=4096", "--max-http-header-size=32768", "apps/admin/server.js"]