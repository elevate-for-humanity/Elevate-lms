FROM node:22-bookworm-slim

ARG NF_GIT_SHA=MISSING

WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV STUDIO_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
COPY services/studio-browser/package.json services/studio-browser/package-lock.json ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /tmp/* \
    && useradd --create-home --uid 1001 studio \
    && chown -R studio:studio /app
COPY services/studio-browser/server.mjs ./server.mjs

ENV NODE_ENV=production PORT=3100 GIT_SHA=${NF_GIT_SHA}
EXPOSE 3100
USER studio
CMD ["node", "server.mjs"]
