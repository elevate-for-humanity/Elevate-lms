FROM node:22-bookworm-slim
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NODE_ENV=production REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate && apt-get update && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ultimate-course-worker/package.json ./packages/ultimate-course-worker/package.json
RUN pnpm install --prod --strict-peer-dependencies=false --filter @elevate/ultimate-course-worker... --no-frozen-lockfile --lockfile=false
COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib/ultimate-course-builder ./lib/ultimate-course-builder
COPY lib/ai/ai-service.ts lib/ai/cloudflare-natural-voice.ts ./lib/ai/
COPY lib/media/licensed-course-media.ts ./lib/media/licensed-course-media.ts
COPY lib/video/remotion-render.ts lib/video/edge-tts.ts lib/video/media-director.ts lib/video/media-quality-gate.ts ./lib/video/
COPY lib/config ./lib/config
COPY lib/logger.ts lib/secrets.ts ./lib/
COPY remotion-src ./remotion-src
COPY server/video-generator ./server/video-generator
COPY public ./public
RUN node -e "require.resolve('@supabase/supabase-js');require.resolve('@remotion/renderer');require.resolve('tsx')" && test ! -d node_modules/stripe
CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]