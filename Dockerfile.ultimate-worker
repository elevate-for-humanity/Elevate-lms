# The approved CPU narration/alignment runtime is immutable and already smoke-tested.
# Source changes replace the complete builder; no lesson output/checkpoint is copied.
FROM us-central1-docker.pkg.dev/elegant-racer-299721/elevate/ultimate-worker@sha256:c3ff77f903eeb1621312d295fa05cb380b60ccc513028955fa00f98ca4159d35
WORKDIR /app
# Resolve aliases from this release, independent of the pinned runtime's config.
COPY tsconfig.ultimate-worker.json ./tsconfig.json
ENV TSX_TSCONFIG_PATH=/app/tsconfig.json
COPY workers/ultimate-course-builder.ts workers/worker-loop.mjs ./workers/
COPY lib/ultimate-course-builder ./lib/ultimate-course-builder
COPY lib/apprenticeship/registered-program-contract.ts ./lib/apprenticeship/registered-program-contract.ts
COPY lib/compliance/appendix-a-standards.ts ./lib/compliance/appendix-a-standards.ts
COPY lib/curriculum/blueprints ./lib/curriculum/blueprints
COPY lib/curriculum/registered-beauty ./lib/curriculum/registered-beauty
COPY lib/media/licensed-course-media.ts ./lib/media/licensed-course-media.ts
COPY lib/video ./lib/video
COPY remotion-src ./remotion-src
COPY lib/storage ./lib/storage
COPY lib/ai ./lib/ai
COPY docs/ultimate-course-builder/lessons/cosmetology-welcome.blueprint.json ./docs/ultimate-course-builder/lessons/cosmetology-welcome.blueprint.json
COPY tests/integration/google-lesson-author.test.ts tests/integration/approved-teaching-recaps.test.ts ./tests/integration/
COPY tests/worker/narration-storage-reference.test.mjs tests/worker/kokoro-liveness-smoke.mjs ./tests/worker/
COPY tests/worker/hvac-saved-safety-role.test.mjs ./tests/worker/
RUN find lib -type f -name '*.ts' -exec sed -i "/^import 'server-only';$/d" {} +
RUN node --test lib/ultimate-course-builder/instructional/competency-classification.test.mjs lib/ultimate-course-builder/media/playback-source.test.mjs && node --import=tsx --test tests/integration/google-lesson-author.test.ts tests/integration/approved-teaching-recaps.test.ts
RUN node --test tests/worker/narration-storage-reference.test.mjs
RUN node --test tests/worker/hvac-saved-safety-role.test.mjs
RUN node --input-type=module -e "import assert from 'node:assert/strict'; const guards=await import('./lib/ultimate-course-builder/worker/runtime-guards.mjs'); assert.equal(typeof guards.createWorkerSupabaseFetch,'function'); assert.equal(typeof guards.createLeaseDeadline,'function');"
# Compile the actual copied composition so an inherited renderer cannot silently
# survive a source release. This is compilation, not learner/media approval.
RUN node --input-type=module -e "import {bundle} from '@remotion/bundler'; import {rm} from 'node:fs/promises'; const output=await bundle({entryPoint:'/app/remotion-src/index.ts',publicDir:'/app/public'}); await rm(output,{recursive:true,force:true});"
RUN node workers/local-speech-smoke.mjs
RUN AI_NARRATION_PROVIDER=kokoro node --import=tsx tests/worker/kokoro-liveness-smoke.mjs
RUN node --import=tsx -e "await Promise.all([import('./lib/ultimate-course-builder/adapters/platform-narration.ts'),import('./lib/ultimate-course-builder/adapters/platform-renderer.ts'),import('./lib/ultimate-course-builder/core/full-course-runner.ts'),import('./lib/ultimate-course-builder/worker/process-job.ts')])"
CMD ["node","--import=tsx","workers/ultimate-course-builder.ts"]
