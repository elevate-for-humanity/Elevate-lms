# ============================================================
# ELEVATE FOR HUMANITY - PRODUCTION ENVIRONMENT
# ============================================================
# Copy this file to .env.production and fill in all values
# NEVER commit .env.production to version control!

# =============================================================================
# SECTION 1: DATABASE & SUPABASE
# =============================================================================

# Get these from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
POSTGRES_URL=postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
POSTGRES_PASSWORD=your-db-password

# =============================================================================
# SECTION 2: AUTHENTICATION
# =============================================================================

NEXTAUTH_SECRET=generate-a-32-character-random-string
NEXTAUTH_URL=https://www.elevateforhumanity.org
NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org

# =============================================================================
# SECTION 3: ORGANIZATION IDENTITY
# =============================================================================

NEXT_PUBLIC_ORG_NAME=Elevate for Humanity
NEXT_PUBLIC_ORG_LEGAL_NAME=Elevate for Humanity Technical and Career Institute
NEXT_PUBLIC_SUPPORT_EMAIL=support@elevateforhumanity.org
NEXT_PUBLIC_SUPPORT_PHONE=(317) 314-3757
NEXT_PUBLIC_EMAIL_FROM_NAME=Elevate for Humanity
NEXT_PUBLIC_EMAIL_FROM_ADDRESS=noreply@elevateforhumanity.org
NEXT_PUBLIC_CERT_HOLDER=Elevate for Humanity
NEXT_PUBLIC_CANONICAL_DOMAIN=www.elevateforhumanity.org

# =============================================================================
# SECTION 4: PAYMENTS - STRIPE
# =============================================================================

# Get from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Store webhook for digital products
STRIPE_WEBHOOK_SECRET_STORE=whsec_...

# Stripe Price IDs - Create these in Stripe Dashboard > Products
STRIPE_PRICE_CR_GUIDE=price_...
STRIPE_PRICE_CR_ENTERPRISE=price_...
STRIPE_PRICE_APPLICATION_FEE=price_...
STRIPE_PRICE_STARTER_LICENSE=price_...
STRIPE_PRICE_PRO_LICENSE=price_...
STRIPE_PRICE_ENTERPRISE_LICENSE=price_...
STRIPE_PRICE_WORKFLOW_STUDIO=price_...
STRIPE_PRICE_TESTING_CENTER=price_...
STRIPE_PRICE_DEV_STUDIO=price_...

# BNPL Payment Plans
STRIPE_PRICE_BNPL_WEEKLY=price_...
STRIPE_PRICE_BNPL_MONTHLY=price_...

# =============================================================================
# SECTION 5: EMAIL - RESEND (Recommended)
# =============================================================================

# Get from Resend.com > API Keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@elevateforhumanity.org
EMAIL_FROM_NAME=Elevate for Humanity

# Alternative: SendGrid
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@elevateforhumanity.org

# =============================================================================
# SECTION 6: AI - CLAUDE (Anthropic)
# =============================================================================

# Get from Anthropic Console > API Keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# SECTION 7: AI - OPENAI (Backup)
# =============================================================================

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# =============================================================================
# SECTION 8: MEDIA - PEXELS (Stock Photos)
# =============================================================================

# Get from Pexels.com > API
PEXELS_API_KEY=...

# =============================================================================
# SECTION 9: JOB BOARD - ADZUNA
# =============================================================================

# Get from Adzuna.com > Developer API
ADZUNA_APP_ID=...
ADZUNA_APP_KEY=...
ADZUNA_COUNTRY=us

# =============================================================================
# SECTION 10: FILE STORAGE - CLOUDFLARE R2
# =============================================================================

# Get from Cloudflare Dashboard > R2 > Manage API Tokens
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=elevate-media

# Apprentice handbook PDF
HANDBOOK_PDF_URL=https://your-bucket.r2.dev/handbooks/apprentice-handbook.pdf

# =============================================================================
# SECTION 11: LICENSING SYSTEM
# =============================================================================

LICENSING_MODE=production
LICENSING_SECRET_KEY=generate-a-secure-random-key

# =============================================================================
# SECTION 12: SOCIAL MEDIA APIs (Optional)
# =============================================================================

# Facebook Graph API
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
FACEBOOK_ACCESS_TOKEN=...

# LinkedIn API
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...

# Twitter/X API
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...

# TikTok API
TIKTOK_APP_KEY=...
TIKTOK_APP_SECRET=...

# =============================================================================
# SECTION 13: NORTHFLANK DEPLOYMENT
# =============================================================================

# These are set automatically by Northflank
NORTHFLANK_PROJECT_ID=...
NORTHFLANK_SERVICE_ID=...
NODE_ENV=production

# =============================================================================
# SECTION 14: LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=info
SENTRY_DSN=... (optional)
