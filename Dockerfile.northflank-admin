# Dockerfile.northflank-admin
# Optimized for 8GB Heap / Admin routes ONLY
# REVERTED TO SUCCESS BUILD LOGIC with SPLIT optimization

FROM node:22-bookworm AS builder

# Cache invalidation
RUN echo "nf-cache-invalidate-20260629-admin-final"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 build-essential ca-certificates libcairo2-dev libpango1.0-dev \
    libjpeg-dev libgif-dev librsvg2-dev && rm -rf /var/lib/apt/lists/*

# Stable PNPM 9.12.3
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

# 1. Install dependencies - NO frozen lockfile (Matches SUCCESS build)
ENV NODE_ENV=production
RUN pnpm install --no-frozen-lockfile

# 2. Copy source
COPY . .

# 3. SPLIT optimization: Stay under 8GB
ENV BUILD_SCOPE=ADMIN
RUN node scripts/split-app.mjs

# 4. Build Admin with 6GB heap safety
ENV NODE_OPTIONS=--max-old-space-size=6144
ENV NEXT_STANDALONE_OUTPUT=1
RUN pnpm --filter @elevate/admin build

# --- Runner ---
FROM node:22-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NODE_OPTIONS=--max-old-space-size=4096

# Exact COPY structure from SUCCESS build
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder /app/apps/admin/.next/server ./apps/admin/.next/server
COPY --from=builder /app/public ./public
COPY --from=builder /app/apps/admin/public ./apps/admin/public

# REQUIRED: Copy full node_modules to preserve pnpm symlinks
COPY --from=builder /app/node_modules ./node_modules

# REQUIRED: Copy custom server file
COPY --from=builder /app/apps/admin/server.js ./apps/admin/server.js

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/api/health/northflank || exit 1

CMD ["node", "apps/admin/server.js"]
