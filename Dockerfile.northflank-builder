# syntax=docker/dockerfile:1.7
# Standalone Elevate Website Builder service.
# This container is intentionally isolated from Marketing and has no production domain cutover.
FROM node:22-bookworm-slim AS base
ARG PNPM_VERSION=10.28.2
ENV CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/website-builder/package.json ./apps/website-builder/package.json
# Bootstrap exception: the standalone app is new on this isolation branch, so
# its importer is not yet present in the committed lockfile. The PR must update
# pnpm-lock.yaml before merge to main; production main builds remain frozen.
RUN pnpm install --no-frozen-lockfile --strict-peer-dependencies=false --filter @elevate/website-builder...

FROM base AS builder
ARG NF_GIT_SHA=unknown
ENV NODE_ENV=production \
    NEXT_STANDALONE_OUTPUT=1 \
    GIT_SHA=${NF_GIT_SHA} \
    NEXT_PUBLIC_GIT_SHA=${NF_GIT_SHA}
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY --from=dependencies /workspace/apps/website-builder/node_modules ./apps/website-builder/node_modules
COPY apps/website-builder ./apps/website-builder
RUN pnpm --filter @elevate/website-builder build
RUN test -f /workspace/apps/website-builder/.next/standalone/apps/website-builder/server.js

FROM node:22-bookworm-slim AS runner
ARG NF_GIT_SHA=unknown
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    SERVICE_NAME=elevate-website-builder \
    GIT_SHA=${NF_GIT_SHA} \
    NEXT_PUBLIC_GIT_SHA=${NF_GIT_SHA}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs --create-home nextjs
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/website-builder/.next/standalone/ /app/
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/website-builder/.next/static/ /app/apps/website-builder/.next/static/
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 CMD curl --fail --silent http://127.0.0.1:3000/api/ping >/dev/null || exit 1
CMD ["node", "apps/website-builder/server.js"]
