# syntax=docker/dockerfile:1.7

ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA

FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable
WORKDIR /app

FROM base AS builder

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @elevate/lms build

RUN test -d /app/apps/lms/.next/standalone
RUN test -d /app/apps/lms/.next/static
RUN test -f /app/apps/lms/.next/BUILD_ID

RUN find /app/apps/lms/.next/standalone \
  -maxdepth 6 \
  -type f \
  -name "server.js" \
  -print

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-lms
ENV GIT_SHA=${GIT_SHA}

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs \
  /app/apps/lms/.next/standalone ./

COPY --from=builder --chown=nextjs:nodejs \
  /app/apps/lms/.next/static ./apps/lms/.next/static

COPY --from=builder --chown=nextjs:nodejs \
  /app/apps/lms/public ./apps/lms/public

RUN test -f /app/apps/lms/server.js || test -f /app/server.js

USER nextjs

EXPOSE 3000

CMD ["sh", "-c", "if [ -f /app/apps/lms/server.js ]; then exec node /app/apps/lms/server.js; elif [ -f /app/server.js ]; then exec node /app/server.js; else echo 'LMS server.js missing'; exit 1; fi"]
