{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "baseUrl": ".",
    "paths": {
      "@/lib/stripe/handlers/checkout-session-completed": [
        "../../lib/stripe/handlers/checkout-session-completed-with-store.ts"
      ],
      "@/*": [
        "../../*"
      ],
      "next": [
        "./node_modules/next"
      ],
      "next/*": [
        "./node_modules/next/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
