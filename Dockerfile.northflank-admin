# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-admin - Northflank Admin Service
# Serves admin.elevateforhumanity.org
#
# Fixes applied:
# 1. Native module dependencies (sharp, canvas, pdfkit, fontkit) installed and copied
# 2. Font and image system libraries in both builder and runner stages
# 3. node_modules copied into runtime stage for native module access
# 4. Native module health check in builder stage (fails build if modules unavailable)
# 5. Standalone output used correctly (preserves directory structure)
# 6. Deterministic build identity from Northflank's injected NF_GIT_SHA

ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

ARG PNPM_VERSION=10.28.2

ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1

RUN corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
    && test "$(corepack pnpm --version)" = "${PNPM_VERSION}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        libfontconfig1 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        python3 \
        make \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN echo "nf-cache-invalidate-admin-2026-08-08-nf-git-sha"

# =============================================================================
# STAGE 2: Dependencies
# =============================================================================
FROM base AS dependencies
RUN echo "nf-deps-2026-08-08-nf-git-sha"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages ./packages
RUN set -eux; \
    echo "PATH=${PATH}"; \
    echo "Corepack version:"; \
    corepack --version; \
    echo "Available pnpm commands:"; \
    type -a pnpm || true; \
    echo "Resolved pnpm executable:"; \
    PNPM_BIN="$(command -v pnpm)"; \
    test -n "${PNPM_BIN}"; \
    echo "${PNPM_BIN}"; \
    readlink -f "${PNPM_BIN}" || true; \
    echo "Active pnpm version:"; \
    corepack pnpm --version; \
    test "$(corepack pnpm --version)" = "10.28.2"; \
    echo "Confirming install command supports frozen lockfiles:"; \
    corepack pnpm install --help | grep -E -- 'frozen-lockfile|lockfile'; \
    echo "Installing workspace dependencies:"; \
    corepack pnpm install --frozen-lockfile --strict-peer-dependencies=false

# =============================================================================
# STAGE 3: Builder
# =============================================================================
FROM base AS builder
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NF_GIT_SHA
ARG BUILD_TIMESTAMP
RUN set -eux; \
    echo "Validating NF_GIT_SHA=${NF_GIT_SHA}"; \
    test -n "${NF_GIT_SHA}"; \
    echo "${NF_GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    echo "NF_GIT_SHA validated: ${NF_GIT_SHA}"
ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL:-https://www.elevateforhumanity.org}"
ENV NEXT_PUBLIC_ADMIN_URL="${NEXT_PUBLIC_ADMIN_URL:-https://admin.elevateforhumanity.org}"
ENV NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL:-https://app.elevateforhumanity.org}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"
ENV GIT_SHA="${NF_GIT_SHA}"
ENV GITHUB_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${NF_GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY . .
RUN echo "Verifying build arguments..." && \
    echo "NEXT_PUBLIC_SITE_URL: ${NEXT_PUBLIC_SITE_URL:-MISSING}" && \
    echo "NEXT_PUBLIC_ADMIN_URL: ${NEXT_PUBLIC_ADMIN_URL:-MISSING}" && \
    echo "NEXT_PUBLIC_SUPABASE_URL: ${NEXT_PUBLIC_SUPABASE_URL:+SET}" && \
    echo "NEXT_PUBLIC_SUPABASE_ANON_KEY: ${NEXT_PUBLIC_SUPABASE_ANON_KEY:+SET}" && \
    echo "NF_GIT_SHA: ${NF_GIT_SHA:-MISSING}" && \
    echo "GIT_SHA: ${GIT_SHA:-MISSING}" && \
    echo "BUILD_TIMESTAMP: ${BUILD_TIMESTAMP:-MISSING}" && \
    (test -n "$NEXT_PUBLIC_SUPABASE_URL" || (echo "ERROR: NEXT_PUBLIC_SUPABASE_URL is not set" && exit 1)) && \
    (test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" || (echo "ERROR: NEXT_PUBLIC_SUPABASE_ANON_KEY is not set" && exit 1)) && \
    (test -n "$NF_GIT_SHA" || (echo "ERROR: NF_GIT_SHA is not set" && exit 1)) && \
    echo "All required build arguments verified."
RUN pnpm --filter @elevate/admin build
RUN set -eux; \
    ADMIN_NEXT_DIR="/workspace/apps/admin/.next"; \
    BUILD_ID_FILE="${ADMIN_NEXT_DIR}/BUILD_ID"; \
    SERVER_FILE="${ADMIN_NEXT_DIR}/standalone/apps/admin/server.js"; \
    test -d "${ADMIN_NEXT_DIR}/standalone"; \
    test -d "${ADMIN_NEXT_DIR}/static"; \
    test -f "${BUILD_ID_FILE}"; \
    test -f "${SERVER_FILE}"; \
    test -n "${GIT_SHA}"; \
    test "${GIT_SHA}" != "unknown"; \
    echo "${GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    ACTUAL_BUILD_ID="$(tr -d '\r\n' < "${BUILD_ID_FILE}")"; \
    ACTUAL_SHA="${ACTUAL_BUILD_ID#admin-}"; \
    EXPECTED_PREFIX="$(printf '%s' "${GIT_SHA}" | cut -c1-"${#ACTUAL_SHA}")"; \
    echo "${ACTUAL_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    test "${ACTUAL_SHA}" = "${EXPECTED_PREFIX}"
RUN pnpm --filter @elevate/admin exec node ../../scripts/check-native-modules.cjs

# =============================================================================
# STAGE 4: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner
ARG NF_GIT_SHA
ARG BUILD_TIMESTAMP
LABEL org.opencontainers.image.title="Elevate Admin"
LABEL org.opencontainers.image.revision="${NF_GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV GIT_SHA="${NF_GIT_SHA}"
ENV GITHUB_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${NF_GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl fontconfig libfontconfig1 libfreetype6 libjpeg62-turbo libpng16-16 libwebp7 && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/.next/standalone/ /app/
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/.next/static/ /app/apps/admin/.next/static/
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/public/ /app/apps/admin/public/
COPY --from=builder --chown=nextjs:nodejs /workspace/node_modules /app/node_modules
RUN set -eux; \
    test -f /app/apps/admin/server.js; \
    test -d /app/apps/admin/.next/static; \
    test -d /app/apps/admin/public; \
    test -d /app/node_modules/sharp; \
    test -d /app/node_modules/@napi-rs/canvas; \
    test -d /app/node_modules/fontkit; \
    test -d /app/node_modules/pdfkit
USER nextjs
EXPOSE 3000

# Canonical lightweight container health contract. Deeper native/dependency
# checks remain available through Admin diagnostics, but orchestration probes
# must use /api/ping so they do not couple container liveness to optional tools.
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=90s \
    --retries=5 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:3000/api/ping \
        >/dev/null || exit 1

CMD ["node", "--max-http-header-size=32768", "apps/admin/server.js"]
