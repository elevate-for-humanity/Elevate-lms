{
  "name": "efh-autopilot",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "npx cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --turbopack",
    "build": "pnpm run build:lms:compile",
    "build:lms:compile": "BUILD_SCOPE=1 NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out node_modules pnpm-lock.yaml",
    "cache:clean": "rimraf .next/cache"
  },
  "dependencies": {
    "@sentry/nextjs": "10.32.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.46.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.454.0",
    "next": "15.0.3",
    "react": "19.0.0-rc-66210214-20241030",
    "react-dom": "19.0.0-rc-66210214-20241030",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3"
  },
  "apps": {
    "admin": {
      "dependencies": {
        "react-hot-toast": "^2.6.0",
        "@tiptap/react": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/extension-placeholder": "^3.27.1",
        "@tiptap/extension-character-count": "^3.27.1",
        "tailwindcss": "3.4.18",
        "autoprefixer": "10.4.22",
        "postcss": "8.5.13"
      }
    }
  }
}
