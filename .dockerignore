# Git / IDE
.git
.gitignore
.gitmodules
.github
.cursor
.devcontainer
!.devcontainer/devcontainer.json
.husky
terminals

# Dependencies & build outputs (never send to production builders)
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
.next
**/.next
.turbo
**/.turbo
.cache
**/.cache
dist
**/dist
out
**/out
coverage
playwright-report
test-results
reports
exports
logs
tmp
temp

# Env secrets
.env
.env.*
!.env.example

# Local / archived content
documents
_archived
export
cloudflare-workers
fly-containers

# Not needed to compile Next.js images
supabase
internal-docs
docs
tests
**/__tests__
**/*.spec.ts
**/*.test.ts
**/*.spec.tsx
**/*.test.tsx

# Logs / OS
*.log
*.tsbuildinfo
.DS_Store

# Markdown (keep README for tooling that expects it)
*.md
!README.md

# Google workload-identity credentials must never enter any build context.
gha-creds-*.json
**/gha-creds-*.json

# Nested generated caches and temporary workspaces
# Do not exclude **/reports or **/logs: these names are live Next.js pages and API routes.
**/tmp
**/temp
**/coverage
**/playwright-report
**/test-results
**/*.log
**/*.tsbuildinfo
**/*.map
**/.DS_Store
**/Thumbs.db

# Include only the standalone instructional acceptance test and its source fixture.
!tests
tests/*
!tests/integration
tests/integration/*
!tests/integration/google-lesson-author.test.ts
!docs
docs/*
!docs/ultimate-course-builder
docs/ultimate-course-builder/*
!docs/ultimate-course-builder/lessons
docs/ultimate-course-builder/lessons/*
!docs/ultimate-course-builder/lessons/cosmetology-welcome.blueprint.json

# Worker acceptance checks for the owner-approved teaching format.
!tests/integration/approved-teaching-recaps.test.ts

# Only the approved narration-storage regression fixture enters worker images.
# Keep the general tests/ exclusion and all secret exclusions intact.
!tests/worker
tests/worker/*
!tests/worker/narration-storage-reference.test.mjs

# Native narration must keep heartbeat scheduling live before worker release.
!tests/worker/kokoro-liveness-smoke.mjs

# Saved HVAC narration safety acceptance must run in the worker image.
!tests/worker/hvac-saved-safety-role.test.mjs
