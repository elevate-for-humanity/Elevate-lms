{
  "name": "efh-autopilot",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "npx cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --turbopack",
    "build": "pnpm run build:lms:compile",
    "build:lms:compile": "pnpm exec cross-env BUILD_SCOPE=1 NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out node_modules pnpm-lock.yaml"
  },
  "dependencies": {
    "@sentry/nextjs": "8.54.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.46.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.11",
    "lucide": "^0.454.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^2.13.3",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
