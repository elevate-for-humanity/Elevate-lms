# Additional required runtime environment variables
#
# This file documents server-only dependencies referenced by app/ and lib/.
# Values here are placeholders only. Set real secrets in Northflank/CI or the
# approved secret store for the target environment.

# Admin authentication and session policy
ADMIN_MFA_REQUIRED=false
SESSION_TIMEOUT_MINUTES=30
ALLOWED_ORIGINS=

# Canonical deployed-service identity and agentic executor readiness.
# SERVICE_ROLE remains the Northflank service-role input during rollout;
# Admin instrumentation normalizes it to ELEVATE_SERVICE=admin before starting
# the shared executor. ELEVATE_AGENTIC_EXECUTOR_STARTED is runtime-derived and
# must not be manually forced true in production.
ELEVATE_SERVICE=
ELEVATE_AGENTIC_EXECUTOR_STARTED=

# Public application intake hardening
APPLICATION_INTAKE_ALLOWED_ORIGINS=https://www.elevateforhumanity.org,https://elevateforhumanity.org
APPLICATION_INTAKE_IDEMPOTENCY_TTL_SECONDS=86400

# Internal server-to-server calls and Dev Studio preview wiring
INTERNAL_API_SECRET=
DEVSTUDIO_PREVIEW_URL=http://localhost:3000
DEVSTUDIO_DEFAULT_PREVIEW_URL=http://localhost:3000

# Unified application URL — used for cross-app redirects (admin → app portal)
UNIFIED_APP_URL=https://app.elevateforhumanity.org
# Generic URL runtime variable referenced by deployed code/tooling.
URL=

# GitHub / Northflank deployment identity
GITHUB_REPOSITORY=elevate-for-humanity/Elevate-lms
NORTHFLANK_MARKETING_SERVICE_ID=

# Stripe webhook signing secrets. Keep real values only in approved secret stores.
STRIPE_WEBHOOK_SECRET_APPLICATION_FEE=
STRIPE_WEBHOOK_SECRET_HOST_SHOP=
STRIPE_WEBHOOK_SECRET_SUBSCRIPTIONS=
STRIPE_CONNECT_WEBHOOK_SECRET=

# HubSpot Free CRM. Keep sync disabled until the private app token is configured
# in the runtime secret store and contact write authorization has been verified.
HUBSPOT_SYNC_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=

# Website Builder custom-domain service (server-only).
DOMAINEE_API_KEY=
DOMAINEE_WEBHOOK_SECRET=
# Added to Domainee's pass-through cost. 1000 = $10.00.
DOMAIN_RETAIL_MARKUP_CENTS=1000

# Supabase server compatibility
SUPABASE_SECRET_KEY=

# AI providers and document intelligence
GOOGLE_GENERATIVE_AI_API_KEY=
AZURE_REASONING_DEPLOYMENT=
AZURE_REASONING_EFFORT=medium
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
OPENAI_MODEL=
OPENAI_API_BASE=
OPENAI_BASE_URL=
OPENHANDS_API_URL=
OPENHANDS_MODEL=
# Claude/Anthropic is optional. When configured, Elevate may use Claude for
# reasoning-heavy admin workflows, tool selection, and document intelligence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DOCUMENT_MODEL=claude-sonnet-4-20250514
# Supported values: anthropic | claude | azure. Leave blank for automatic selection.
AI_REASONING_PROVIDER=

# Workforce and career data feeds
CAREERONESTOP_TOKEN=
INDIANA_CAREER_CONNECT_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# Scheduling and social integrations
CALENDLY_API_TOKEN=
