FROM node:22-bookworm-slim AS base
ARG PNPM_VERSION=10.28.2
RUN corepack disable || true && npm install -g "pnpm@${PNPM_VERSION}"
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false
COPY . .
FROM base AS runner
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng ffmpeg ca-certificates fontconfig fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY --from=base /workspace /workspace
CMD ["pnpm","exec","tsx","workers/ultimate-course-builder.ts"]
