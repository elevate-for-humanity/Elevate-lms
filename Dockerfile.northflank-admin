# syntax=docker/dockerfile:1.7

ARG GIT_SHA=unknown

FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

ENV NEXT_STANDALONE_OUTPUT=1
RUN corepack enable
WORKDIR /app

FROM base AS builder

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @elevate/admin build

# Check standalone output exists
RUN test -d /app/apps/admin/.next/standalone
RUN test -d /app/apps/admin/.next/static
RUN test -f /app/apps/admin/.next/BUILD_ID

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV GIT_SHA=${GIT_SHA}

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public

# Copy node_modules for dependencies
COPY --from=builder /app/node_modules ./node_modules

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
