FROM node:22-bookworm-slim

ARG NF_GIT_SHA=MISSING

WORKDIR /app
ENV STUDIO_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
COPY services/studio-browser/requirements-artifacts.txt ./requirements-artifacts.txt
COPY services/studio-browser/package.json services/studio-browser/package-lock.json ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation unzip zip git bash python3 python3-venv poppler-utils ffmpeg ripgrep \
    && python3 -m venv /opt/studio-python \
    && /opt/studio-python/bin/pip install --no-cache-dir -r requirements-artifacts.txt \
    && corepack enable \
    && corepack prepare pnpm@10.28.2 --activate \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /tmp/* \
    && useradd --create-home --uid 1001 studio \
    && mkdir -p /workspace/project \
    && chown -R studio:studio /app /workspace
ENV PATH="/opt/studio-python/bin:${PATH}" MPLBACKEND=Agg
COPY services/studio-browser/create-artifact.py ./create-artifact.py
RUN python3 /app/create-artifact.py --self-test
COPY services/studio-browser/workspace-artifacts.mjs ./workspace-artifacts.mjs
COPY services/studio-browser/repository-push.mjs ./repository-push.mjs
COPY services/studio-browser/command-arguments.mjs ./command-arguments.mjs
COPY services/studio-browser/server.mjs ./server.mjs
COPY services/studio-browser/cdp-*.mjs ./
COPY services/studio-browser/workspace-checkpoint.mjs ./workspace-checkpoint.mjs
COPY services/studio-browser/repository-sync.mjs ./repository-sync.mjs
COPY services/studio-browser/gcs-workspace-objects.mjs ./gcs-workspace-objects.mjs
COPY services/studio-browser/browser-file-store.mjs ./browser-file-store.mjs
COPY services/studio-browser/browser-workspace-store.mjs ./browser-workspace-store.mjs
COPY services/studio-browser/provider-session-store.mjs ./provider-session-store.mjs
COPY services/studio-browser/session-retirement.mjs ./session-retirement.mjs
COPY services/studio-browser/session-expiration.mjs ./session-expiration.mjs
COPY services/studio-browser/terminal-sessions.mjs ./terminal-sessions.mjs
COPY services/studio-browser/terminal-init.sh ./terminal-init.sh
COPY services/studio-browser/provider-verification.mjs ./provider-verification.mjs
COPY services/studio-browser/course-video-download.mjs ./course-video-download.mjs
COPY services/studio-browser/learner-runthrough.mjs ./learner-runthrough.mjs
RUN node --input-type=module -e "await import('./server.mjs')"

ENV NODE_ENV=production PORT=3100 GIT_SHA=${NF_GIT_SHA}
EXPOSE 3100
USER studio
CMD ["node", "server.mjs"]
