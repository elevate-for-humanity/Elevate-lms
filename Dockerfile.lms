# syntax=docker/dockerfile:1.7
# Dockerfile.lms - Northflank LMS Service
# Serves app.elevateforhumanity.org
#
# CRITICAL: This Dockerfile was fixed to resolve path mismatches between
# standalone server.js and static file locations.

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

# Install Python for native module builds (node-pty)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE_OUTPUT=1

# Cache invalidation marker
RUN echo "nf-cache-invalidate-lms-2026-07-20-v7"

RUN corepack enable
WORKDIR /app

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM base AS builder

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/lms/package.json ./apps/lms/package.json
COPY packages/*/package.json ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

# Copy source code
COPY . .

# Build args
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_SERVICE_ROLE_KEY
ARG GIT_SHA
ARG BUILD_TIMESTAMP

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CI=true
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Build LMS app
RUN pnpm --filter @elevate/lms build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN echo "=== LMS BUILD VERIFICATION ===" && \
    echo "Checking standalone directory..." && \
    test -d /app/apps/lms/.next/standalone && echo "✓ Standalone dir exists" || (echo "✗ Standalone dir MISSING!"; exit 1) && \
    echo "Checking static directory..." && \
    test -d /app/apps/lms/.next/static && echo "✓ Static dir exists" || (echo "✗ Static dir MISSING!"; exit 1) && \
    echo "Checking BUILD_ID..." && \
    test -f /app/apps/lms/.next/BUILD_ID && echo "✓ BUILD_ID exists" || (echo "✗ BUILD_ID MISSING!"; exit 1) && \
    echo "Checking server.js location..." && \
    find /app/apps/lms/.next/standalone -name "server.js" -type f && echo "✓ server.js found" || (echo "✗ server.js MISSING!"; exit 1) && \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# STAGE 3: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV SERVICE_NAME=elevate-lms
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Copy standalone build (contains server.js at root of standalone/)
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/standalone ./

# Copy ALL required Next.js build artifacts to correct locations
# CRITICAL: Need .next/server for route manifests and build metadata
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/server ./.next/server
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/public ./public

# Copy node_modules (needed for runtime dependencies)
COPY --from=builder /app/node_modules ./node_modules

# =============================================================================
# VERIFICATION: Runtime stage - MUST fail build if server.js missing
# =============================================================================
RUN echo "=== RUNTIME VERIFICATION ===" && \
    echo "Current directory: $(pwd)" && \
    echo "Contents of /app:" && \
    ls -la /app/ && \
    echo "" && \
    if [ -f "/app/server.js" ]; then \
        echo "✓ server.js found at /app/server.js"; \
        ls -la /app/server.js; \
    else \
        echo "✗ CRITICAL: server.js NOT found at /app/server.js"; \
        echo "Searching for server.js in /app:"; \
        find /app -name "server.js" -type f 2>/dev/null || echo "Not found anywhere"; \
        exit 1; \
    fi && \
    if [ -d "/app/.next/server" ]; then \
        echo "✓ .next/server directory found"; \
    else \
        echo "✗ CRITICAL: .next/server directory MISSING"; \
        exit 1; \
    fi && \
    if [ -d "/app/.next/static" ]; then \
        echo "✓ .next/static found"; \
    else \
        echo "✗ CRITICAL: .next/static NOT found"; \
        exit 1; \
    fi && \
    if [ -d "/app/public" ]; then \
        echo "✓ public found"; \
    else \
        echo "✗ CRITICAL: public NOT found"; \
        exit 1; \
    fi && \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 8080

# Health check - use the actual app port
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://127.0.0.1:8080/api/ping || exit 1

# Start server from /app/ where server.js is located
CMD ["node", "--max-http-header-size=32768", "server.js"]
