# syntax=docker/dockerfile:1.7
# Dockerfile.marketing - Northflank Marketing Service
# Serves www.elevateforhumanity.org
#
# CRITICAL: This Dockerfile was fixed to resolve path mismatches.

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE_OUTPUT=1

# Cache invalidation marker - v4 remove all verification
RUN echo "nf-cache-invalidate-marketing-2026-07-20-v4"

RUN corepack enable
WORKDIR /app

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM base AS builder

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages/*/package.json ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

# Copy source code
COPY . .

# Build args
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GIT_SHA
ARG BUILD_TIMESTAMP

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CI=true
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Build Marketing app
RUN pnpm --filter @elevate/marketing build

# =============================================================================
# STAGE 3: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Copy standalone build to /app/ root (server.js expects paths from /app/)
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/standalone ./

# DEBUG: Check what we have
RUN echo "=== DEBUG: Contents of standalone directory ===" && \
    ls -la /app/apps/marketing/.next/standalone/ 2>/dev/null || echo "standalone dir not found" && \
    find /app/apps/marketing/.next/standalone -name "server.js" 2>/dev/null && \
    echo "=== END DEBUG ==="

# Copy ALL required Next.js build artifacts to correct locations
# CRITICAL: Need .next/server for route manifests and build metadata
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/server ./.next/server
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/public ./public

# Copy node_modules (needed for runtime dependencies)
COPY --from=builder /app/node_modules ./node_modules

# DEBUG: Check what we have after copy
RUN echo "=== DEBUG: Contents of /app after copy ===" && \
    ls -la /app/ && \
    test -f /app/server.js && echo "server.js FOUND" || echo "server.js NOT FOUND" && \
    echo "=== END DEBUG ==="

USER nextjs

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://127.0.0.1:3000/api/ping || exit 1

# Start server from /app/ where server.js is located
CMD ["node", "--max-http-header-size=32768", "server.js"]
