FROM node:22-bookworm-slim
WORKDIR /app
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev --no-audit --no-fund @supabase/supabase-js tsx
COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib/ultimate-course-builder/worker/job-queue.ts ./lib/ultimate-course-builder/worker/job-queue.ts
ENV NODE_ENV=production
CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]
