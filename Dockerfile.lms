FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable
RUN corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/lms/package.json ./apps/lms/package.json

RUN pnpm install --frozen-lockfile

FROM base AS builder

ARG GITHUB_SHA=unknown
ARG GIT_SHA=unknown
ARG NEXT_PUBLIC_GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=16384"
ENV NEXT_STANDALONE_OUTPUT=1
ENV GITHUB_SHA=$GITHUB_SHA
ENV GIT_SHA=$GIT_SHA
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/lms/node_modules ./apps/lms/node_modules

COPY . .

RUN pnpm --filter @elevate/lms build

RUN test -d /app/apps/lms/.next
RUN test -f /app/apps/lms/.next/BUILD_ID

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 nodejs \
    && adduser -S -u 1001 -G nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/standalone ./apps
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/standalone/package.json ./

COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/static ./apps/lms/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/.next/server ./apps/lms/.next/server
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/public ./apps/lms/public

# Copy custom server.js (this takes precedence over Next.js standalone server.js)
COPY --from=builder --chown=nextjs:nodejs /app/apps/lms/server.js ./apps/lms/server.js

# Copy node_modules for the server.js to work - need next from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/lms/node_modules ./apps/lms/node_modules

RUN if [ -f "/app/apps/lms/server.js" ]; then \
      echo "Found server.js at /app/apps/lms/server.js"; \
    else \
      echo "ERROR: No runnable server.js in runtime image"; \
      find /app -maxdepth 5 -name "server.js" -print; \
      exit 1; \
    fi

USER nextjs

EXPOSE 3000

CMD ["node", "--max-old-space-size=4096", "--max-http-header-size=32768", "apps/lms/server.js"]
