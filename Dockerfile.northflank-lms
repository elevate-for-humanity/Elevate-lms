# Dockerfile.northflank-lms
# Builds and serves the LMS application (apps/lms/)
# Serves app.elevateforhumanity.org
#
# Northflank Configuration:
#   - Build type: Dockerfile
#   - Dockerfile path: /Dockerfile.northflank-lms
#   - Build context: /

# Build args available across ALL stages (required for multi-stage ARG passthrough)
ARG GITHUB_SHA=unknown
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ARG BUILD_ID=unknown

FROM node:22-bookworm AS builder

# Cache invalidation marker - fixed githubsha args matching trigger-build.ts
RUN echo "nf-cache-invalidate-lms-2026-07-20-v6-arg-before-from"

# Install system deps for native modules (sharp, canvas, pdf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    ca-certificates \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Use pnpm@10.28.2 to match lockfileVersion 9.0 (pnpm 10.x format)
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

ENV PNPM_HOME="/app/.pnpm-home"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

# Copy manifests and source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Increased memory for native module stability
ENV NODE_OPTIONS=--max-old-space-size=12288
ENV NEXT_STANDALONE_OUTPUT=1
ENV BUILD_SCOPE=LMS
ENV CI=true
ENV DISABLE_WEBPACK_FILESYSTEM_CACHE=1

# Install dependencies with strict peer checking disabled for compatibility
RUN pnpm install --no-frozen-lockfile --strict-peer-dependencies=false

# Build Next.js LMS app - ARG declarations must come BEFORE ENV usage
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_SERVICE_ROLE_KEY
ARG GITHUB_SHA
ARG GIT_SHA
ARG BUILD_TIMESTAMP
ARG BUILD_ID
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY
ENV GITHUB_SHA=${GITHUB_SHA}
ENV GIT_SHA=${GIT_SHA:-${GITHUB_SHA}}
ENV BUILD_ID=${BUILD_ID}
ENV NEXT_PUBLIC_GIT_SHA=${GITHUB_SHA}
ENV NEXT_PUBLIC_BUILD_VERSION=${GITHUB_SHA}
ENV NEXT_PUBLIC_COMMIT_SHA=${GITHUB_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# EVIDENCE: Print all build arguments to see what Northflank passed
RUN echo "=== DOCKER BUILD EVIDENCE (LMS) ===" && \
    echo "GITHUB_SHA=${GITHUB_SHA}" && \
    echo "GIT_SHA=${GIT_SHA}" && \
    echo "BUILD_TIMESTAMP=${BUILD_TIMESTAMP}" && \
    echo "BUILD_ID=${BUILD_ID}" && \
    echo "FALLBACK_COMMIT=${FALLBACK_COMMIT}" && \
    echo "" && \
    echo "All environment variables starting with GIT:" && \
    printenv | grep -i git || echo "(none)" && \
    echo "All environment variables starting with NEXT_PUBLIC:" && \
    printenv | grep -i next_public || echo "(none)" && \
    echo "=== END DOCKER BUILD EVIDENCE ==="

RUN pnpm run build:lms:compile --no-lint

# INSPECTION: Show standalone directory structure to verify correct CMD
# This MUST fail the build if standalone is not created properly
RUN echo "=== STANDALONE STRUCTURE ===" && \
    if [ -d "/app/apps/lms/.next/standalone" ]; then \
        find /app/apps/lms/.next/standalone -maxdepth 4 -type f | sort; \
        echo "--- Verifying server.js location ---"; \
        find /app/apps/lms/.next/standalone -name "server.js" -type f; \
    else \
        echo "ERROR: No standalone directory found!"; \
        echo "Expected at: /app/apps/lms/.next/standalone"; \
        echo "Next.js standalone build may have failed."; \
        exit 1; \
    fi

# --- runtime stage ---
FROM node:22-bookworm-slim

# Install runtime deps for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-liberation \
    libcairo2 \
    libpango-1.0-0 \
    libjpeg62-turbo \
    libgif7 \
    librsvg2-2 \
    librsvg2-common \
    && rm -rf /var/lib/apt/lists/*

# ARG declarations must come BEFORE ENV usage in each stage
ARG GITHUB_SHA
ARG GIT_SHA
ARG BUILD_TIMESTAMP
ARG BUILD_ID
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=8080
ENV NODE_OPTIONS=--max-old-space-size=8192 --gc-interval=100
ENV GITHUB_SHA=${GITHUB_SHA}
ENV GIT_SHA=${GIT_SHA:-${GITHUB_SHA}}
ENV BUILD_ID=${BUILD_ID}
ENV NEXT_PUBLIC_GIT_SHA=${GITHUB_SHA}
ENV NEXT_PUBLIC_BUILD_VERSION=${GITHUB_SHA}
ENV NEXT_PUBLIC_COMMIT_SHA=${GITHUB_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

# Copy standalone build artifacts
# The Next.js standalone output creates server.js that handles all routes
# CRITICAL: This copies CONTENTS of standalone/ to /app/, so server.js ends up at /app/server.js
COPY --from=builder /app/apps/lms/.next/standalone ./

# Verify standalone server.js exists at expected location BEFORE copying other files
RUN echo "=== RUNTIME VERIFICATION ===" && \
    if [ -f "/app/server.js" ]; then \
        echo "✅ Standalone server.js found at /app/server.js"; \
        ls -la /app/server.js; \
    else \
        echo "ERROR: server.js not found at /app/server.js"; \
        echo "Contents of /app:"; \
        ls -la /app/; \
        echo "Standalone directory exists:"; \
        ls -la /app/apps/lms/.next/standalone/ 2>/dev/null || echo "Source directory not found"; \
        exit 1; \
    fi

COPY --from=builder /app/apps/lms/.next/static ./.next/static
COPY --from=builder /app/apps/lms/.next/server ./.next/server
COPY --from=builder /app/apps/lms/public ./public

# Copy full node_modules from builder (preserves pnpm symlinks)
COPY --from=builder /app/node_modules ./node_modules

# Final verification before exposing port
RUN echo "=== FINAL IMAGE VERIFICATION ===" && \
    test -f /app/server.js && echo "✅ Final: server.js exists" && \
    test -d /app/.next/static && echo "✅ Final: .next/static exists" && \
    test -d /app/node_modules && echo "✅ Final: node_modules exists" && \
    echo "Image is ready for deployment"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/api/ping || exit 1

# Use standalone server.js from /app/ (NOT apps/lms/server.js which is dev custom server)
# The standalone output contains a production-ready server that handles all Next.js routes
CMD ["node", "--max-http-header-size=32768", "server.js"]
