FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
# Standalone worker dependency contract: do not load the monorepo workspace/root manifest.
COPY packages/ultimate-course-worker/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY workers/ultimate-course-builder.ts ./workers/ultimate-course-builder.ts
COPY lib/ultimate-course-builder ./lib/ultimate-course-builder
COPY lib/ai/ai-service.ts lib/ai/cloudflare-natural-voice.ts ./lib/ai/
COPY lib/media/licensed-course-media.ts ./lib/media/licensed-course-media.ts
COPY lib/config ./lib/config
COPY lib/logger.ts lib/secrets.ts ./lib/
COPY remotion-src ./remotion-src
COPY public ./public
RUN node -e "require.resolve('@supabase/supabase-js');require.resolve('@remotion/renderer');require.resolve('tsx')"  && test ! -d node_modules/stripe && test ! -d node_modules/next && test ! -d node_modules/@sentry
CMD ["./node_modules/.bin/tsx","workers/ultimate-course-builder.ts"]