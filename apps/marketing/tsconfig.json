{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "../../components/**/*.ts",
    "../../components/**/*.tsx",
    "../../config/**/*.ts",
    "../../contexts/**/*.ts",
    "../../contexts/**/*.tsx",
    "../../data/**/*.ts",
    "../../data/**/*.tsx",
    "../../hooks/**/*.ts",
    "../../hooks/**/*.tsx",
    "../../lib/**/*.ts",
    "../../lib/**/*.tsx",
    "../../packages/shared/**/*.ts",
    "../../packages/shared/**/*.tsx",
    "../../types/**/*.ts",
    "../../types/**/*.d.ts",
    "./**/*.js",
    "./**/*.mjs",
    "./**/*.ts",
    "./**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../apps/admin",
    "../../apps/lms",
    "../../app-legacy",
    "../../scripts",
    "../../server",
    "../../supabase",
    "../../tests",
    "../../tools",
    "../../workers",
    "../../**/*.test.ts",
    "../../**/*.test.tsx",
    "../../**/*.spec.ts",
    "../../**/*.spec.tsx"
  ]
}
