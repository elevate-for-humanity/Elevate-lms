# Dockerfile.northflank-admin
# Optimized for Admin routes ONLY

FROM node:22-bookworm AS builder

# Cache invalidation marker
RUN echo "nf-cache-invalidate-20260707-admin-v1"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    ca-certificates \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first (for better caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

# Install pnpm directly via npm
RUN npm install -g pnpm@9.15.9

ENV PNPM_HOME="/app/.pnpm-home"
ENV PATH="$PNPM_HOME:$PATH"

# Copy source
COPY . .

# Critical ENV variables (must be set before install)
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=8192
ENV NEXT_STANDALONE_OUTPUT=1
ENV BUILD_SCOPE=ADMIN
ENV CI=true
ENV DISABLE_WEBPACK_FILESYSTEM_CACHE=1

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build Admin with 8GB heap
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV NEXT_PUBLIC_COMMIT_SHA=$COMMIT_SHA
ENV NEXT_PUBLIC_BUILD_TIME=$BUILD_TIME
RUN pnpm --filter @elevate/admin build

# --- runtime stage ---
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=8080

WORKDIR /app

# Copy standalone build (admin structure)
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder /app/apps/admin/.next/server ./apps/admin/.next/server
COPY --from=builder /app/public ./public
COPY --from=builder /app/apps/admin/public ./apps/admin/public

# Copy full node_modules from builder (preserves pnpm symlinks)
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/admin || exit 1

CMD ["node", "--max-http-header-size=32768", "apps/admin/server.js"]
