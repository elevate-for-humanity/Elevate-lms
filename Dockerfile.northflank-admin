# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-admin - Northflank Admin Service
# Serves admin.elevateforhumanity.org
#
# CRITICAL: This Dockerfile was fixed to resolve path mismatches.

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE_OUTPUT=1

# Cache invalidation marker
RUN echo "nf-cache-invalidate-admin-2026-07-20-v2"

RUN corepack enable
WORKDIR /app

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM base AS builder

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages/*/package.json ./packages/

# Install dependencies (remove --frozen-lockfile to allow lockfile migration)
# pnpm 10.x can migrate lockfiles from pnpm 9.x
RUN pnpm install --strict-peer-dependencies=false

# Copy source code
COPY . .

# Build args
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_SERVICE_ROLE_KEY
ARG GIT_SHA
ARG BUILD_TIMESTAMP

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_ADMIN_URL=${NEXT_PUBLIC_ADMIN_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CI=true
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}
ENV NEXT_STANDALONE_OUTPUT=1

# EVIDENCE: Print all build arguments to see what Northflank passed
RUN echo "=== DOCKER BUILD EVIDENCE (Admin) ===" && \
    echo "GIT_SHA=${GIT_SHA}" && \
    echo "GITHUB_SHA=${GITHUB_SHA}" && \
    echo "BUILD_TIMESTAMP=${BUILD_TIMESTAMP}" && \
    echo "FALLBACK_COMMIT=${FALLBACK_COMMIT}" && \
    echo "" && \
    echo "All environment variables starting with GIT:" && \
    printenv | grep -i git || echo "(none)" && \
    echo "=== END DOCKER BUILD EVIDENCE ==="

# Build Admin app
RUN pnpm --filter @elevate/admin build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN echo "=== ADMIN BUILD VERIFICATION ===" && \
    echo "Checking standalone directory..." && \
    test -d /app/apps/admin/.next/standalone && echo "✓ Standalone dir exists" || (echo "✗ Standalone dir MISSING!"; exit 1) && \
    echo "Checking static directory..." && \
    test -d /app/apps/admin/.next/static && echo "✓ Static dir exists" || (echo "✗ Static dir MISSING!"; exit 1) && \
    echo "Checking BUILD_ID..." && \
    test -f /app/apps/admin/.next/BUILD_ID && echo "✓ BUILD_ID exists" || (echo "✗ BUILD_ID MISSING!"; exit 1) && \
    echo "Checking server.js location..." && \
    find /app/apps/admin/.next/standalone -name "server.js" -type f && echo "✓ server.js found" || (echo "✗ server.js MISSING!"; exit 1) && \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# STAGE 3: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

# Declare build args for runtime stage
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# Copy standalone build to /app/ root
# The standalone output preserves the full monorepo path structure (apps/admin/)
# so server.js ends up at /app/apps/admin/.next/standalone/apps/admin/server.js
# We need to extract the actual app files from the nested structure
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone /app/

# Move the actual app files from the nested structure to /app/
# The standalone output has apps/admin/server.js, apps/admin/package.json, etc.
RUN if [ -f /app/apps/admin/server.js ]; then \
        mv /app/apps/admin/server.js /app/server.js; \
    fi && \
    if [ -f /app/apps/admin/package.json ]; then \
        mv /app/apps/admin/package.json /app/package.json; \
    fi && \
    rm -rf /app/apps

# Copy ALL required Next.js build artifacts to correct locations
# Copy FULL .next directory so the standalone server finds BUILD_ID and all root-level files
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./public

# Copy node_modules (needed for runtime dependencies)
COPY --from=builder /app/node_modules ./node_modules

# =============================================================================
# VERIFICATION: Runtime stage
# =============================================================================
RUN echo "=== RUNTIME VERIFICATION ===" && \
    echo "Current directory: $(pwd)" && \
    echo "Contents of /app:" && \
    ls -la /app/ && \
    echo "" && \
    if [ -f "/app/server.js" ]; then \
        echo "✓ server.js found at /app/server.js"; \
    else \
        echo "✗ CRITICAL: server.js NOT found at /app/server.js"; \
        echo "Searching for server.js:"; \
        find /app -name "server.js" -type f 2>/dev/null; \
        exit 1; \
    fi && \
    if [ -d "/app/.next/server" ]; then \
        echo "✓ .next/server directory found"; \
    else \
        echo "✗ CRITICAL: .next/server directory MISSING"; \
        exit 1; \
    fi && \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://127.0.0.1:3000/api/ping || exit 1

# Start server from /app/ where server.js is located
CMD ["node", "--max-http-header-size=32768", "server.js"]
