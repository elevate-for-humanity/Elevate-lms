{
  "name": "efh-autopilot",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "npx cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --turbopack",
    "build": "pnpm run build:lms:compile",
    "build:lms:compile": "npx cross-env BUILD_SCOPE=1 NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out node_modules pnpm-lock.yaml",
    "cache:clean": "rimraf .next/cache"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.18",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.63.0",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.46.1",
    "@tiptap/extension-character-count": "^3.27.2",
    "@tiptap/extension-placeholder": "^3.27.2",
    "@tiptap/react": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "next": "15.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "signature_pad": "^5.1.3",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
