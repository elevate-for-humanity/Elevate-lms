# Dockerfile.northflank-admin
# Optimized for Admin routes ONLY
#
# Northflank Configuration:
#   - Build type: Dockerfile
#   - Dockerfile path: /Dockerfile.northflank-admin
#   - Build context: /

# Build args available across ALL stages (required for multi-stage ARG passthrough)
ARG GITHUB_SHA=unknown
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ARG BUILD_ID=unknown

FROM node:22-bookworm AS builder

# Cache invalidation marker
RUN echo "nf-cache-invalidate-admin-2026-07-20-v5-arg-before-from"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    ca-certificates \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

ENV PNPM_HOME="/app/.pnpm-home"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

# Copy manifests and source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY . .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=8192
ENV NEXT_STANDALONE_OUTPUT=1
ENV BUILD_SCOPE=ADMIN
ENV CI=true
ENV DISABLE_WEBPACK_FILESYSTEM_CACHE=1

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build Admin - ARG declarations must come BEFORE ENV usage
ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_SERVICE_ROLE_KEY
ARG GITHUB_SHA
ARG GIT_SHA
ARG BUILD_TIMESTAMP
ARG BUILD_ID
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY
ENV GITHUB_SHA=${GITHUB_SHA}
ENV GIT_SHA=${GIT_SHA:-${GITHUB_SHA}}
ENV BUILD_ID=${BUILD_ID}
ENV NEXT_PUBLIC_GIT_SHA=${GITHUB_SHA}
ENV NEXT_PUBLIC_BUILD_VERSION=${GITHUB_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Verify build args
RUN echo "Admin Build SHA: ${GITHUB_SHA}" && echo "Admin Build Timestamp: ${BUILD_TIMESTAMP}"

RUN pnpm --filter @elevate/admin build --no-lint

# INSPECTION: Show standalone directory structure to verify correct CMD
RUN echo "=== STANDALONE STRUCTURE ===" && find /app/apps/admin/.next/standalone -maxdepth 4 -type f 2>/dev/null | sort || echo "No standalone directory found"

# --- runtime stage ---
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# ARG declarations must come BEFORE ENV usage in each stage
ARG GITHUB_SHA
ARG GIT_SHA
ARG BUILD_TIMESTAMP
ARG BUILD_ID
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV GITHUB_SHA=${GITHUB_SHA}
ENV GIT_SHA=${GIT_SHA:-${GITHUB_SHA}}
ENV BUILD_ID=${BUILD_ID}
ENV NEXT_PUBLIC_GIT_SHA=${GITHUB_SHA}
ENV NEXT_PUBLIC_BUILD_VERSION=${GITHUB_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}
ENV SERVICE_NAME=admin

WORKDIR /app

# Copy standalone build artifacts
# The Next.js standalone output preserves workspace structure
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder /app/apps/admin/.next/server ./apps/admin/.next/server
COPY --from=builder /app/apps/admin/public ./apps/admin/public

# Verify standalone server.js exists at expected location
RUN test -f /app/server.js && echo "Standalone server.js found at /app/server.js" || (echo "ERROR: server.js not found at /app/server.js" && exit 1)

# Copy full node_modules from builder (preserves pnpm symlinks)
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

# Health check: /api/ping returns {status:ok} reliably
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -sf http://127.0.0.1:3000/api/ping || curl -sf http://127.0.0.1:3000/ || exit 1

# Use standalone server.js from /app/ (NOT apps/admin/server.js which is custom dev server)
# The standalone output contains a production-ready server that handles all Next.js routes
CMD ["node", "--max-http-header-size=32768", "server.js"]
