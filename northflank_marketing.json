{
  "serviceType": "web",
  "name": "elevate-marketing",
  "billing": {
    "deploymentPlan": "nf-compute-400"
  },
  "buildEngineConfiguration": {
    "buildEngine": "buildkit"
  },
  "vcsData": {
    "projectUrl": "https://github.com/elevate-for-humanity/Elevate-lms",
    "projectBranch": "main",
    "dockerFilePath": "/Dockerfile.marketing",
    "dockerWorkDir": "/"
  },
  "deployment": {
    "healthCheck": {
      "enabled": true,
      "path": "/",
      "port": 8080,
      "protocol": "HTTP"
    },
    "replicas": {
      "min": 1,
      "max": 3
    },
    "resources": {
      "cpu": "4000m",
      "memory": "8192Mi"
    }
  }
}
