# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-marketing - Northflank Marketing Service
# Serves www.elevateforhumanity.org

# GIT_SHA must be a real full SHA — no default allowed in production.
# CI/CD MUST pass: --build-arg GIT_SHA=$(git rev-parse HEAD)
ARG GIT_SHA
ARG BUILD_TIMESTAMP

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/root/.pnpm"
ENV PATH="/usr/local/bin:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

# Install native build toolchain + pnpm@10
# Using npm install -g instead of corepack because corepack's prepare/activate
# does not reliably create working shims in Docker build environments.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.28.2 \
    && echo "Installed pnpm version:" && pnpm --version

WORKDIR /workspace

# Cache invalidation marker — changes when GIT_SHA changes
RUN echo "nf-cache-invalidate-marketing-GIT_SHA"

# =============================================================================
# STAGE 2: Dependencies
# =============================================================================
FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages ./packages

# Note: --mount=type=cache is NOT used because Northflank's no_cache:true does
# not invalidate BuildKit mount caches. The standard layer cache is properly
# invalidated by no_cache:true and Dockerfile content changes.
RUN pnpm install \
      --frozen-lockfile \
      --strict-peer-dependencies=false

# =============================================================================
# STAGE 3: Builder
# =============================================================================
FROM base AS builder

ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GIT_SHA
ARG BUILD_TIMESTAMP

# Strict SHA validation — fail immediately if unknown or all zeros.
RUN echo "Validating GIT_SHA=${GIT_SHA}" && \
    (test -n "${GIT_SHA}" || (echo "ERROR: GIT_SHA is required but not set" && exit 1)) && \
    (test "${GIT_SHA}" != "unknown" || (echo "ERROR: GIT_SHA cannot be 'unknown'" && exit 1)) && \
    (echo "${GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$' || (echo "ERROR: GIT_SHA must be 7-40 hex characters, got '${GIT_SHA}'" && exit 1)) && \
    echo "GIT_SHA validated: ${GIT_SHA}"

ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"
ENV GIT_SHA="${GIT_SHA}"
ENV GITHUB_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

# Copy installed dependencies first
COPY --from=dependencies /workspace/node_modules ./node_modules

# Copy the full repository source afterward
COPY . .

# Build Marketing app
RUN pnpm --filter @elevate/marketing build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN set -eux; \
    echo "=== MARKETING BUILD VERIFICATION ==="; \
    test -d /workspace/apps/marketing/.next/standalone && echo "✓ Standalone dir exists"; \
    test -d /workspace/apps/marketing/.next/static && echo "✓ Static dir exists"; \
    test -f /workspace/apps/marketing/.next/BUILD_ID && echo "✓ BUILD_ID exists"; \
    echo "Expected BUILD_ID: ${GIT_SHA}"; \
    echo "Actual BUILD_ID: $(cat /workspace/apps/marketing/.next/BUILD_ID)"; \
    test "$(cat /workspace/apps/marketing/.next/BUILD_ID)" = "${GIT_SHA}" && echo "✓ BUILD_ID matches GIT_SHA" || (echo "ERROR: BUILD_ID mismatch!" && exit 1); \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# STAGE 4: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ARG GIT_SHA
ARG BUILD_TIMESTAMP

LABEL org.opencontainers.image.title="Elevate Marketing"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA="${GIT_SHA}"
ENV GITHUB_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

WORKDIR /app

# Install curl for HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs

# Copy standalone build
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/standalone \
    ./

# Static assets
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/static \
    ./apps/marketing/.next/static/

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/public \
    ./apps/marketing/public/

# =============================================================================
# VERIFICATION: Runtime stage
# =============================================================================
RUN set -eux; \
    echo "=== RUNTIME VERIFICATION ==="; \
    test -f /app/apps/marketing/server.js && echo "✓ server.js exists"; \
    test -d /app/apps/marketing/.next/static && echo "✓ Static dir exists"; \
    test -d /app/apps/marketing/public && echo "✓ Public dir exists"; \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 3000

# Readiness probe: /api/health returns 200 with commit SHA
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=120s \
    --retries=5 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:3000/api/health \
        >/dev/null || exit 1

CMD ["node", "--max-old-space-size=4096", "apps/marketing/server.js"]
