# The workflow supplies only the authenticated, pinned standalone source as context.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends util-linux && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS builder
COPY . .
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_SUPABASE_URL=https://vhulnzcfmlnsmoxixjco.supabase.co
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
RUN test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY"
RUN node .elevate-build/prepare-legacy83-config.mjs
RUN SUPABASE_SERVICE_ROLE_KEY=build-only-no-live-access node .elevate-build/run-bounded-build.mjs -- npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
RUN groupadd --system --gid 1001 legacy83 && useradd --system --uid 1001 --gid legacy83 legacy83
COPY --from=builder --chown=legacy83:legacy83 /app/.next/standalone ./
COPY --from=builder --chown=legacy83:legacy83 /app/.next/static ./.next/static
COPY --from=builder --chown=legacy83:legacy83 /app/public ./public
USER legacy83
EXPOSE 8080
CMD ["node", "server.js"]
