# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-admin - Northflank Admin Service
# Serves admin.elevateforhumanity.org
#
# Fixes applied:
# 1. Explicit COPY commands for package.json (prevents wildcard flattening)
# 2. SUPABASE_SERVICE_ROLE_KEY is runtime-only (not embedded in image)
# 3. curl installed in runtime stage for HEALTHCHECK
# 4. Standalone output used correctly (preserves directory structure)
# 5. server.js stays at apps/admin/server.js (not moved to /app/)

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

# Cache invalidation marker
RUN echo "nf-cache-invalidate-admin-2026-07-28"

WORKDIR /workspace

# =============================================================================
# STAGE 2: Manifests
# Preserve monorepo directory structure explicitly.
# =============================================================================
FROM base AS manifests

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json

# Copy each shared package manifest explicitly (not packages/*/package.json)
COPY packages/config/package.json ./packages/config/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/supabase/package.json ./packages/supabase/package.json

# =============================================================================
# STAGE 3: Dependencies
# =============================================================================
FROM manifests AS dependencies

RUN --mount=type=cache,id=pnpm-admin,target=/pnpm/store \
    pnpm install --frozen-lockfile --strict-peer-dependencies=false

# =============================================================================
# STAGE 4: Builder
# =============================================================================
FROM base AS builder

ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"

ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL}"
ENV NEXT_PUBLIC_ADMIN_URL="${NEXT_PUBLIC_ADMIN_URL}"
ENV NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"

ENV GIT_SHA="${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

COPY --from=dependencies /workspace/node_modules ./node_modules
COPY --from=dependencies /workspace/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=dependencies /workspace/packages ./packages

COPY . .

# Build Admin app
RUN pnpm --filter @elevate/admin build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN set -eux; \
    echo "=== ADMIN BUILD VERIFICATION ==="; \
    test -d /workspace/apps/admin/.next/standalone && echo "✓ Standalone dir exists"; \
    test -d /workspace/apps/admin/.next/static && echo "✓ Static dir exists"; \
    test -f /workspace/apps/admin/.next/BUILD_ID && echo "✓ BUILD_ID exists"; \
    test -f /workspace/apps/admin/.next/standalone/apps/admin/server.js && echo "✓ server.js at apps/admin/server.js"; \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# STAGE 5: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.title="Elevate Admin"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV GIT_SHA="${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

WORKDIR /app

# Install curl for HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs

# Copy standalone build (preserves apps/admin/ directory structure)
# server.js will be at /app/apps/admin/server.js
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/.next/standalone/ \
    /app/

# Static assets
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/.next/static/ \
    /app/apps/admin/.next/static/

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/public/ \
    /app/apps/admin/public/

# =============================================================================
# VERIFICATION: Runtime stage
# =============================================================================
RUN set -eux; \
    echo "=== RUNTIME VERIFICATION ==="; \
    test -f /app/apps/admin/server.js && echo "✓ server.js at /app/apps/admin/server.js"; \
    test -d /app/apps/admin/.next/static && echo "✓ Static dir exists"; \
    test -d /app/apps/admin/public && echo "✓ Public dir exists"; \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 3000

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=90s \
    --retries=5 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:3000/api/ping \
        >/dev/null || exit 1

# Start from the correct location (apps/admin/)
CMD ["node", "--max-http-header-size=32768", "apps/admin/server.js"]
