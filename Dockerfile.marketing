# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /workspace

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages ./packages

RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

FROM base AS builder

ARG GITHUB_SHA=unknown
ARG GIT_SHA=unknown
ARG NEXT_PUBLIC_GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV GITHUB_SHA=$GITHUB_SHA
ENV GIT_SHA=$GIT_SHA
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP

COPY --from=dependencies /workspace/node_modules ./node_modules

COPY . .

RUN pnpm --filter @elevate/marketing build

RUN test -d /workspace/apps/marketing/.next
RUN test -f /workspace/apps/marketing/.next/BUILD_ID

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 nodejs && adduser -S -u 1001 -G nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/standalone \
    ./

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/static \
    ./apps/marketing/.next/static/

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/public \
    ./apps/marketing/public/

# Fix: Next.js standalone output inherits "type":"module" from the monorepo
# root package.json, but server.js is compiled as CommonJS. Remove it so
# Node.js treats server.js as CommonJS (no require/import mismatch).
RUN sed -i '/"type": *"module"/d' /app/package.json 2>/dev/null || true

USER nextjs

EXPOSE 3000

CMD ["node", "--max-old-space-size=4096", "apps/marketing/server.js"]
