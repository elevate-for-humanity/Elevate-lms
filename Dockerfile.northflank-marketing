# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-marketing - Northflank Marketing Service
# Serves www.elevateforhumanity.org

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1
ENV GIT_SHA=${GIT_SHA}
ENV BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Install native build toolchain
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.28.2 --activate

WORKDIR /workspace

# Cache invalidation marker
RUN echo "nf-cache-invalidate-marketing-$(date +%Y%m%d)"

# =============================================================================
# STAGE 2: Dependencies
# =============================================================================
FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json
COPY packages ./packages

RUN --mount=type=cache,id=pnpm-marketing,target=/pnpm/store \
    pnpm install \
      --frozen-lockfile \
      --strict-peer-dependencies=false

# =============================================================================
# STAGE 3: Builder
# =============================================================================
FROM base AS builder

ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"
ENV GIT_SHA="${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

# Copy installed dependencies first
COPY --from=dependencies /workspace/node_modules ./node_modules

# Copy the full repository source afterward
COPY . .

# Build Marketing app
RUN pnpm --filter @elevate/marketing build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN set -eux; \
    echo "=== MARKETING BUILD VERIFICATION ==="; \
    test -d /workspace/apps/marketing/.next/standalone && echo "✓ Standalone dir exists"; \
    test -d /workspace/apps/marketing/.next/static && echo "✓ Static dir exists"; \
    test -f /workspace/apps/marketing/.next/BUILD_ID && echo "✓ BUILD_ID exists"; \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# STAGE 4: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.title="Elevate Marketing"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA="${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

WORKDIR /app

# Install curl for HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs

# Copy standalone build
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/standalone \
    ./

# Static assets
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/.next/static \
    ./apps/marketing/.next/static/

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/marketing/public \
    ./apps/marketing/public/

# =============================================================================
# VERIFICATION: Runtime stage
# =============================================================================
RUN set -eux; \
    echo "=== RUNTIME VERIFICATION ==="; \
    test -f /app/apps/marketing/server.js && echo "✓ server.js exists"; \
    test -d /app/apps/marketing/.next/static && echo "✓ Static dir exists"; \
    test -d /app/apps/marketing/public && echo "✓ Public dir exists"; \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 3000

# Readiness probe: /api/health returns 200 with commit SHA
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=120s \
    --retries=5 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:3000/api/health \
        >/dev/null || exit 1

CMD ["node", "--max-old-space-size=4096", "apps/marketing/server.js"]
