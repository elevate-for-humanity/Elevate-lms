{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "../../**/*.js",
    "../../**/*.mjs",
    "../../**/*.ts",
    "../../**/*.tsx",
    "./**/*.js",
    "./**/*.mjs",
    "./**/*.ts",
    "./**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
