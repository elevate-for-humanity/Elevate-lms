{
  "healthChecks": [
    {
      "protocol": "HTTP",
      "type": "readinessProbe",
      "port": 8080,
      "path": "/api/health/northflank",
      "initialDelaySeconds": 60,
      "periodSeconds": 30,
      "timeoutSeconds": 10,
      "failureThreshold": 3,
      "successThreshold": 1
    }
  ]
}
