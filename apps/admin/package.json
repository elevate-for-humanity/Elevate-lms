{
  "name": "@elevate/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node ../../scripts/check-build-memory-policy.mjs && node ../../scripts/sync-pwa-public.mjs admin",
    "build": "node ../../scripts/run-bounded-build.mjs -- node ../../scripts/build-next-app.mjs",
    "prestart": "node ../../scripts/sync-pwa-public.mjs admin",
    "start": "node server.js",
    "lint": "node ../../scripts/run-bounded-build.mjs -- node ../../node_modules/eslint/bin/eslint.js . --ext .js,.jsx,.ts,.tsx --quiet",
    "predev": "node ../../scripts/sync-development-public.mjs admin"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "fontkit": "^2.0.4",
    "next": "catalog:",
    "pdfkit": "^0.18.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "autoprefixer": "10.4.22",
    "postcss": "^8.5.13",
    "tailwindcss": "3.4.18",
    "typescript": "^5"
  }
}
