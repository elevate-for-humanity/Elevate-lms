# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-admin - Northflank Admin Service
# Serves admin.elevateforhumanity.org
#
# Production contract:
# 1. Native module dependencies are installed and verified.
# 2. Next.js standalone output is the authoritative production server.
# 3. Build identity comes from Northflank's injected NF_GIT_SHA.
# 4. The final packaged runtime must boot and serve /api/ping before the image is accepted.

ARG BUILD_TIMESTAMP=unknown

FROM node:22-bookworm-slim AS base

ARG PNPM_VERSION=10.28.2

ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1

RUN corepack disable || true \
    && npm install -g "pnpm@${PNPM_VERSION}" \
    && test "$(pnpm --version)" = "${PNPM_VERSION}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        libfontconfig1 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        python3 \
        make \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN echo "nf-cache-invalidate-admin-2026-08-22-remotion-runtime-source"

FROM base AS dependencies
RUN echo "nf-deps-2026-08-13-block-ffmpeg-static-postinstall"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages ./packages
# Runtime ships Debian FFmpeg. Prevent ffmpeg-static from downloading a second
# binary during dependency installation, which has historically failed on
# Northflank with ECONNRESET.
RUN node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); if (p.pnpm?.onlyBuiltDependencies) p.pnpm.onlyBuiltDependencies=p.pnpm.onlyBuiltDependencies.filter((name)=>name!=='ffmpeg-static'); fs.writeFileSync('package.json', JSON.stringify(p,null,2)+'\n');"
RUN set -eux; \
    PNPM_BIN="$(command -v pnpm)"; \
    test -n "${PNPM_BIN}"; \
    echo "pnpm=${PNPM_BIN} version=$(pnpm --version)"; \
    test "$(pnpm --version)" = "10.28.2"; \
    pnpm install --help | grep -E -- 'frozen-lockfile|lockfile'; \
    pnpm install --frozen-lockfile --strict-peer-dependencies=false

FROM base AS builder
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NF_GIT_SHA
ARG BUILD_TIMESTAMP
RUN set -eux; \
    test -n "${NF_GIT_SHA}"; \
    echo "${NF_GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    echo "NF_GIT_SHA validated: ${NF_GIT_SHA}"
ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL:-https://www.elevateforhumanity.org}"
ENV NEXT_PUBLIC_ADMIN_URL="${NEXT_PUBLIC_ADMIN_URL:-https://admin.elevateforhumanity.org}"
ENV NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL:-https://app.elevateforhumanity.org}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"
ENV GIT_SHA="${NF_GIT_SHA}"
ENV GITHUB_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${NF_GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY . .
RUN set -eux; \
    test -n "$NEXT_PUBLIC_SUPABASE_URL"; \
    test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY"; \
    test -n "$NF_GIT_SHA"; \
    test -f /workspace/remotion-src/index.ts; \
    echo "Admin build arguments verified"
RUN pnpm --filter @elevate/admin build
RUN node scripts/verify-admin-critical-routes.mjs
RUN set -eux; \
    ADMIN_NEXT_DIR="/workspace/apps/admin/.next"; \
    BUILD_ID_FILE="${ADMIN_NEXT_DIR}/BUILD_ID"; \
    GENERATED_SERVER_FILE="${ADMIN_NEXT_DIR}/standalone/apps/admin/server.js"; \
    test -d "${ADMIN_NEXT_DIR}/standalone"; \
    test -d "${ADMIN_NEXT_DIR}/static"; \
    test -f "${BUILD_ID_FILE}"; \
    test -f "${GENERATED_SERVER_FILE}"; \
    test -n "${GIT_SHA}"; \
    test "${GIT_SHA}" != "unknown"; \
    echo "${GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    ACTUAL_BUILD_ID="$(tr -d '\r\n' < "${BUILD_ID_FILE}")"; \
    ACTUAL_SHA="${ACTUAL_BUILD_ID#admin-}"; \
    EXPECTED_PREFIX="$(printf '%s' "${GIT_SHA}" | cut -c1-"${#ACTUAL_SHA}")"; \
    echo "${ACTUAL_SHA}" | grep -qE '^[a-f0-9]{7,40}$'; \
    test "${ACTUAL_SHA}" = "${EXPECTED_PREFIX}"
RUN pnpm --filter @elevate/admin exec node ../../scripts/check-native-modules.cjs

FROM node:22-bookworm-slim AS runner
ARG NF_GIT_SHA
ARG BUILD_TIMESTAMP
LABEL org.opencontainers.image.title="Elevate Admin"
LABEL org.opencontainers.image.revision="${NF_GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV ELEVATE_SERVICE=admin
ENV GIT_SHA="${NF_GIT_SHA}"
ENV GITHUB_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${NF_GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${NF_GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates chromium curl espeak-ng ffmpeg fontconfig fonts-dejavu-core fonts-liberation \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libcairo2 libcups2 libdbus-1-3 libdrm2 \
    libfontconfig1 libfreetype6 libgbm1 libjpeg62-turbo libnspr4 libnss3 libpango-1.0-0 \
    libpng16-16 libwebp7 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 && \
    test -x /usr/bin/chromium && \
    ! ldd /usr/lib/chromium/chromium 2>&1 | grep -q 'not found' && \
    chromium --headless --no-sandbox --disable-gpu --dump-dom about:blank >/tmp/chromium-smoke.html && \
    grep -qi '<html' /tmp/chromium-smoke.html && \
    rm -f /tmp/chromium-smoke.html && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs

# Keep Next.js's generated standalone launcher. Do not overwrite it with the
# repository's custom development/server harness.
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/.next/standalone/ /app/
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/.next/static/ /app/apps/admin/.next/static/
COPY --from=builder --chown=nextjs:nodejs /workspace/public/ /app/apps/admin/public/
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/admin/public/ /app/apps/admin/public/
# Remotion is bundled dynamically at render time. The standalone server changes
# cwd to /app/apps/admin, so package the canonical repo-root composition there.
COPY --from=builder --chown=nextjs:nodejs /workspace/remotion-src/ /app/apps/admin/remotion-src/
COPY --from=builder --chown=nextjs:nodejs /workspace/node_modules /app/node_modules
RUN set -eux; \
    test -f /app/apps/admin/server.js; \
    test -d /app/apps/admin/.next/static; \
    test -f /app/apps/admin/.next/required-server-files.json; \
    test -d /app/apps/admin/public; \
    test -d /app/apps/admin/public/images; \
    test -f /app/apps/admin/remotion-src/index.ts; \
    test -f /app/apps/admin/remotion-src/Root.tsx; \
    test -d /app/node_modules/sharp; \
    test -d /app/node_modules/@napi-rs/canvas; \
    test -d /app/node_modules/fontkit; \
    test -d /app/node_modules/pdfkit; \
    command -v ffmpeg; \
    command -v ffprobe; \
    fc-match 'DejaVu Sans'

RUN set -eux; \
    LOG=/tmp/admin-runtime-smoke.log; \
    node --max-http-header-size=32768 apps/admin/server.js >"${LOG}" 2>&1 & \
    PID=$!; \
    trap 'cat "${LOG}" || true; kill "${PID}" 2>/dev/null || true' EXIT; \
    READY=0; \
    for attempt in $(seq 1 30); do \
      if curl --fail --silent --show-error http://127.0.0.1:3000/api/ping >/tmp/admin-ping.json 2>/tmp/admin-ping.err; then \
        READY=1; \
        break; \
      fi; \
      if ! kill -0 "${PID}" 2>/dev/null; then \
        echo 'Admin standalone process exited during packaged-runtime smoke test.'; \
        cat "${LOG}"; \
        exit 1; \
      fi; \
      sleep 2; \
    done; \
    if [ "${READY}" -ne 1 ]; then \
      echo 'Admin packaged standalone runtime did not become healthy.'; \
      cat /tmp/admin-ping.err || true; \
      cat "${LOG}"; \
      exit 1; \
    fi; \
    cat /tmp/admin-ping.json; \
    kill "${PID}"; \
    wait "${PID}" || true; \
    trap - EXIT

USER nextjs
EXPOSE 3000

HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=90s \
    --retries=5 \
    CMD curl --fail --silent --show-error http://127.0.0.1:3000/api/ping >/dev/null || exit 1

CMD ["node", "--max-http-header-size=32768", "apps/admin/server.js"]
