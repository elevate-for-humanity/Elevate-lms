FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable
RUN corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/package.json

RUN pnpm install --frozen-lockfile

FROM base AS builder

ARG GITHUB_SHA=unknown
ARG GIT_SHA=unknown
ARG NEXT_PUBLIC_GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1
ENV GITHUB_SHA=$GITHUB_SHA
ENV GIT_SHA=$GIT_SHA
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/marketing/node_modules ./apps/marketing/node_modules

COPY . .

RUN pnpm --filter @elevate/marketing build

RUN test -d /app/apps/marketing/.next
RUN test -f /app/apps/marketing/.next/BUILD_ID

RUN if [ -f /app/apps/marketing/.next/standalone/server.js ]; then \
      echo "Standalone server found at workspace level"; \
    elif [ -f /app/apps/marketing/.next/standalone/apps/marketing/server.js ]; then \
      echo "Standalone server found at monorepo app level"; \
    else \
      echo "ERROR: standalone server.js was not generated"; \
      find /app/apps/marketing/.next -maxdepth 5 -name "server.js" -print; \
      exit 1; \
    fi

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup \
      -g 1001 \
      nodejs \
    && adduser \
      -S \
      -u 1001 \
      -G nodejs \
      nextjs

COPY --from=builder \
  --chown=nextjs:nodejs \
  /app/apps/marketing/.next/standalone \
  ./

COPY --from=builder \
  --chown=nextjs:nodejs \
  /app/apps/marketing/.next/static \
  ./apps/marketing/.next/static

COPY --from=builder \
  --chown=nextjs:nodejs \
  /app/apps/marketing/public \
  ./apps/marketing/public

RUN if [ -f /app/apps/marketing/server.js ]; then \
      cp /app/apps/marketing/server.js /app/server.js; \
    elif [ -f /app/server.js ]; then \
      true; \
    else \
      echo "ERROR: No runnable server.js in runtime image"; \
      find /app -maxdepth 5 -name "server.js" -print; \
      exit 1; \
    fi

USER nextjs

EXPOSE 3000

CMD ["node", "--max-old-space-size=4096", "server.js"]
