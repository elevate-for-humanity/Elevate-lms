# syntax=docker/dockerfile:1.7

ARG GIT_SHA=unknown

FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

ENV NEXT_STANDALONE_OUTPUT=1
RUN corepack enable
WORKDIR /app

FROM base AS builder

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @elevate/marketing build

# Check standalone output exists
RUN test -d /app/apps/marketing/.next/standalone
RUN test -d /app/apps/marketing/.next/static
RUN test -f /app/apps/marketing/.next/BUILD_ID

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-marketing
ENV GIT_SHA=${GIT_SHA}

WORKDIR /app

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs

# In monorepo Next.js standalone, server.js is at apps/marketing/server.js
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/standalone ./apps/marketing/
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/.next/static ./apps/marketing/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/marketing/public ./apps/marketing/public

# Copy node_modules for dependencies
COPY --from=builder /app/node_modules ./node_modules

USER nextjs

EXPOSE 3000

# Run from the marketing app directory where server.js lives
CMD ["node", "apps/marketing/server.js"]
