# syntax=docker/dockerfile:1.7
# Dockerfile.northflank-admin - Northflank Admin Service
# Serves admin.elevateforhumanity.org
#
# Fixes applied:
# 1. Native module dependencies (sharp, canvas, pdfkit, fontkit) installed and copied
# 2. Font and image system libraries in both builder and runner stages
# 3. node_modules copied into runtime stage for native module access
# 4. Native module health check in builder stage (fails build if modules unavailable)
# 5. Standalone output used correctly (preserves directory structure)
# 6. Deterministic build identity — GIT_SHA required, no defaults

ARG BUILD_TIMESTAMP=unknown

# =============================================================================
# STAGE 1: Base
# =============================================================================
FROM node:22-bookworm-slim AS base


ARG PNPM_VERSION=10.28.2


ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1


RUN corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
    && test "$(corepack pnpm --version)" = "${PNPM_VERSION}"


# Install native build toolchain + font/image processing libraries
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        libfontconfig1 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        python3 \
        make \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /workspace


# Cache invalidation marker — changes when Dockerfile content changes
RUN echo "nf-cache-invalidate-admin-2026-07-30-corepack"

# =============================================================================
# STAGE 2: Dependencies
# =============================================================================
FROM base AS dependencies


# Cache invalidation marker — must change to force rebuild with correct pnpm version
RUN echo "nf-deps-2026-07-30-corepack"


COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/package.json


# Copy actual packages directory (preserves structure: db, shared, ui)
COPY packages ./packages


# Note: --mount=type=cache is NOT used here because Northflank's no_cache:true does
# not invalidate BuildKit mount caches. Using the standard build cache which is
# properly invalidated by no_cache:true and Dockerfile content changes.
RUN set -eux; \
    echo "PATH=${PATH}"; \
    echo "Corepack version:"; \
    corepack --version; \
    echo "Available pnpm commands:"; \
    type -a pnpm || true; \
    echo "Resolved pnpm executable:"; \
    PNPM_BIN="$(command -v pnpm)"; \
    test -n "${PNPM_BIN}"; \
    echo "${PNPM_BIN}"; \
    readlink -f "${PNPM_BIN}" || true; \
    echo "Active pnpm version:"; \
    corepack pnpm --version; \
    test "$(corepack pnpm --version)" = "10.28.2"; \
    echo "Confirming install command supports frozen lockfiles:"; \
    corepack pnpm install --help | grep -E -- 'frozen-lockfile|lockfile'; \
    echo "Installing workspace dependencies:"; \
    corepack pnpm install \
      --frozen-lockfile \
      --strict-peer-dependencies=false

# =============================================================================
# STAGE 3: Builder
# =============================================================================
FROM base AS builder

ARG NEXT_PUBLIC_SITE_URL=https://www.elevateforhumanity.org
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.elevateforhumanity.org
ARG NEXT_PUBLIC_APP_URL=https://app.elevateforhumanity.org
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

# GIT_SHA must be a real full SHA in production — no default allowed.
# CI/CD MUST pass: --build-arg GIT_SHA=$(git rev-parse HEAD)
ARG GIT_SHA
ARG BUILD_TIMESTAMP

# Strict SHA validation — fail immediately if unknown or all zeros.
# Also reject if no ARG was passed (empty expansion).
RUN echo "Validating GIT_SHA=${GIT_SHA}" && \
    (test -n "${GIT_SHA}" || (echo "ERROR: GIT_SHA is required but not set" && exit 1)) && \
    (test "${GIT_SHA}" != "unknown" || (echo "ERROR: GIT_SHA cannot be 'unknown'" && exit 1)) && \
    (echo "${GIT_SHA}" | grep -qE '^[a-f0-9]{7,40}$' || (echo "ERROR: GIT_SHA must be 7-40 hex characters, got '${GIT_SHA}'" && exit 1)) && \
    echo "GIT_SHA validated: ${GIT_SHA}"

ENV NODE_ENV=production
ENV CI=true
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NEXT_STANDALONE_OUTPUT=1

ENV NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL}"
ENV NEXT_PUBLIC_ADMIN_URL="${NEXT_PUBLIC_ADMIN_URL}"
ENV NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL}"
ENV NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL}"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY}"

ENV GIT_SHA="${GIT_SHA}"
ENV GITHUB_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

# Copy installed dependencies first
COPY --from=dependencies /workspace/node_modules ./node_modules

# Copy the full repository source afterward
COPY . .

# Verify required build arguments are present (fail-fast before expensive build)
RUN echo "Verifying build arguments..." && \
    echo "NEXT_PUBLIC_SITE_URL: ${NEXT_PUBLIC_SITE_URL:-MISSING}" && \
    echo "NEXT_PUBLIC_ADMIN_URL: ${NEXT_PUBLIC_ADMIN_URL:-MISSING}" && \
    echo "NEXT_PUBLIC_SUPABASE_URL: ${NEXT_PUBLIC_SUPABASE_URL:+SET}" && \
    echo "NEXT_PUBLIC_SUPABASE_ANON_KEY: ${NEXT_PUBLIC_SUPABASE_ANON_KEY:+SET}" && \
    echo "GIT_SHA: ${GIT_SHA:-MISSING}" && \
    echo "BUILD_TIMESTAMP: ${BUILD_TIMESTAMP:-MISSING}" && \
    (test -n "$NEXT_PUBLIC_SUPABASE_URL" || (echo "ERROR: NEXT_PUBLIC_SUPABASE_URL is not set" && exit 1)) && \
    (test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" || (echo "ERROR: NEXT_PUBLIC_SUPABASE_ANON_KEY is not set" && exit 1)) && \
    echo "All required build arguments verified."

# Build Admin app
RUN pnpm --filter @elevate/admin build

# =============================================================================
# VERIFICATION: Builder stage
# =============================================================================
RUN set -eux; \
    echo "=== ADMIN BUILD VERIFICATION ==="; \
    test -d /workspace/apps/admin/.next/standalone && echo "✓ Standalone dir exists"; \
    test -d /workspace/apps/admin/.next/static && echo "✓ Static dir exists"; \
    test -f /workspace/apps/admin/.next/BUILD_ID && echo "✓ BUILD_ID exists"; \
    test -f /workspace/apps/admin/.next/standalone/apps/admin/server.js && echo "✓ server.js at apps/admin/server.js"; \
    echo "Expected BUILD_ID: ${GIT_SHA}"; \
    echo "Actual BUILD_ID: $(cat /workspace/apps/admin/.next/BUILD_ID)"; \
    test "$(cat /workspace/apps/admin/.next/BUILD_ID)" = "${GIT_SHA}" && echo "✓ BUILD_ID matches GIT_SHA" || (echo "ERROR: BUILD_ID mismatch!" && exit 1); \
    echo "=== BUILD VERIFICATION COMPLETE ==="

# =============================================================================
# NATIVE MODULE VERIFICATION: Fail build if native modules unavailable
# =============================================================================
RUN pnpm --filter @elevate/admin exec node \
    ../../scripts/check-native-modules.cjs

# =============================================================================
# STAGE 4: Runtime
# =============================================================================
FROM node:22-bookworm-slim AS runner

ARG GIT_SHA
ARG BUILD_TIMESTAMP

LABEL org.opencontainers.image.title="Elevate Admin"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=elevate-admin
ENV GIT_SHA="${GIT_SHA}"
ENV GITHUB_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_GIT_SHA="${GIT_SHA}"
ENV NEXT_PUBLIC_BUILD_ID="elevate-${GIT_SHA}"
ENV BUILD_TIMESTAMP="${BUILD_TIMESTAMP}"

WORKDIR /app

# Runtime font and image libraries + curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    libfontconfig1 \
    libfreetype6 \
    libjpeg62-turbo \
    libpng16-16 \
    libwebp7 && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --create-home nextjs

# Copy standalone build (preserves apps/admin/ directory structure)
# server.js will be at /app/apps/admin/server.js
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/.next/standalone/ \
    /app/

# Static assets
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/.next/static/ \
    /app/apps/admin/.next/static/

COPY --from=builder --chown=nextjs:nodejs \
    /workspace/apps/admin/public/ \
    /app/apps/admin/public/

# Copy node_modules for native module access (sharp, canvas, fontkit, pdfkit)
# The standalone output does not include native modules — copy the full tree
COPY --from=builder --chown=nextjs:nodejs \
    /workspace/node_modules \
    /app/node_modules

# =============================================================================
# VERIFICATION: Runtime stage
# =============================================================================
RUN set -eux; \
    echo "=== RUNTIME VERIFICATION ==="; \
    test -f /app/apps/admin/server.js && echo "✓ server.js at /app/apps/admin/server.js"; \
    test -d /app/apps/admin/.next/static && echo "✓ Static dir exists"; \
    test -d /app/apps/admin/public && echo "✓ Public dir exists"; \
    test -d /app/node_modules/sharp && echo "✓ sharp in node_modules"; \
    test -d /app/node_modules/@napi-rs/canvas && echo "✓ @napi-rs/canvas in node_modules"; \
    test -d /app/node_modules/fontkit && echo "✓ fontkit in node_modules"; \
    test -d /app/node_modules/pdfkit && echo "✓ pdfkit in node_modules"; \
    echo "=== RUNTIME VERIFICATION PASSED ==="

USER nextjs

EXPOSE 3000

# Readiness probe: /api/health/native returns 200 only when all native modules load
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=90s \
    --retries=5 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1:3000/api/health/native \
        >/dev/null || exit 1

# Start from the correct location (apps/admin/)
CMD ["node", "--max-http-header-size=32768", "apps/admin/server.js"]
