    "audit:casing": "node scripts/check-path-casing.mjs",
    "db:migrate": "node scripts/db/runMigrations.js",
    "db:seed": "node scripts/db/runSeeds.js",
    "db:check": "node scripts/db/checkDatabase.js",
    "install:ci": "pnpm install --frozen-lockfile --strict-peer-dependencies=false",
    "lockfile:sync": "pnpm install --lockfile-only --strict-peer-dependencies=false",
    "lockfile:check": "pnpm install --frozen-lockfile --strict-peer-dependencies=false",
    "typecheck": "pnpm run typecheck:all",
    "typecheck:marketing": "pnpm --filter @elevate/marketing exec tsc --noEmit",
    "typecheck:admin": "pnpm --filter @elevate/admin exec tsc --noEmit",
    "typecheck:lms": "pnpm --filter @elevate/lms exec tsc --noEmit",
    "typecheck:all": "pnpm run typecheck:marketing && pnpm run typecheck:admin && pnpm run typecheck:lms",
